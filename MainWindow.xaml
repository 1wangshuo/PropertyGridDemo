<Window x:Class="PropertyGridDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:PropertyGridLib;assembly=PropertyGridLib"
        xmlns:models="clr-namespace:PropertyGridDemo.Models"
        Title="PropertyGrid Demo - WPF + HandyControl"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <models:SampleObject x:Key="sampleObj"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧：PropertyGrid ========== -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="PropertyGrid 控件"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- 外观设置面板 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="外观设置" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="字体：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="fontFamilyCombo"
                                  SelectionChanged="FontFamily_Changed"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="字号：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="fontSizeCombo"
                                  SelectionChanged="FontSize_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <controls:PropertyGrid x:Name="propertyGrid"
                                   SelectedObject="{StaticResource sampleObj}"
                                   ShowDescription="True"
                                   ShowSearchBar="True"
                                   TitlePlacement="Top"/>
        </DockPanel>

        <!-- ========== 右侧：操作面板 + 实时预览 ========== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="操作面板" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>

                <WrapPanel>
                    <Button Content="重置选中属性" Padding="14,6" Margin="0,0,8,8"
                            Click="ResetSelected_Click"/>
                    <Button Content="重置全部属性" Padding="14,6" Margin="0,0,8,8"
                            Click="ResetAll_Click"/>
                    <Button Content="刷新属性列表" Padding="14,6" Margin="0,0,8,8"
                            Click="Refresh_Click"/>
                    <Button Content="切换主题" Padding="14,6" Margin="0,0,8,8"
                            Click="ToggleTheme_Click"/>
                    <Button Content="切换对象" Padding="14,6" Margin="0,0,8,8"
                            Click="SwitchObject_Click"/>
                    <Button Content="中/EN" Padding="14,6" Margin="0,0,8,8"
                            Click="ToggleLanguage_Click"/>
                    <Button Content="控件独立使用演示" Padding="14,6" Margin="0,0,8,8"
                            Click="CollectionEditorDemo_Click"/>
                    <Button Content="PropertyGridPro 平铺面板演示" Padding="14,6" Margin="0,0,8,8"
                            Click="PropertyGridProDemo_Click"/>
                    <Button x:Name="SmallLayoutButton" Content="Small 紧凑布局" Padding="14,6" Margin="0,0,8,8"
                            Click="ToggleSmallLayout_Click"/>
                    <Button Content="事件编辑器独立演示" Padding="14,6" Margin="0,0,8,8"
                            Click="EventPickerDemo_Click"/>
                </WrapPanel>
            </StackPanel>

            <!-- 实时属性值显示 -->
            <Border Grid.Row="1" Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="8" Padding="16" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="实时属性值（代码读取）"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="propertyValuesText"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 特性支持说明 -->
            <Border Grid.Row="2" Background="{DynamicResource RegionBrush}"
                    CornerRadius="8" Padding="16" Margin="0,8,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="支持的 .NET 特性" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
[Category("分类")]  — 属性分组（「杂项/Misc」分类自动排最后）&#x0a;
[DisplayName("显示名")]  — 自定义显示名称&#x0a;
[Description("描述")]  — 底部描述栏显示&#x0a;
[DefaultValue(value)]  — 默认值 + 重置按钮&#x0a;
[ReadOnly(true)]  — 只读属性&#x0a;
[Browsable(false)]  — 隐藏属性&#x0a;
[Button("文本", nameof(方法))]  — 命令按钮 + 点击事件&#x0a;
[ToggleSwitch("开","关")]  — bool 显示为开关（ToggleSwitch）样式&#x0a;
[MultilineText]  — 长文本：单行预览 + “…”弹出多行富文本编辑&#x0a;
Type 类型属性  — 只读显示，不展开反射元数据
                    </TextBlock>
                    <TextBlock Text="支持的编辑器类型" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,8,0,6"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
string → TextBox（[MultilineText]：单行预览 + 多行富文本弹窗）&#x0a;
bool → 开关样式（默认：仅开关；[ToggleSwitch]：开关 + 开/关文字）&#x0a;
int/double/float → NumericUpDown&#x0a;
enum → ComboBox&#x0a;
DateTime → DatePicker&#x0a;
Color/SolidColorBrush → Color 编辑器（改色不再污染共享画刷）&#x0a;
Type → 只读文本（不展开反射元数据）&#x0a;
复杂对象 → 可展开子属性（嵌套层默认折叠，单点展开）&#x0a;
[Button] 特性 → 命令按钮（触发点击事件）
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

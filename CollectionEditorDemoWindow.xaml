<Window x:Class="PropertyGridDemo.CollectionEditorDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PropertyGridLib;assembly=PropertyGridLib"
        xmlns:local="clr-namespace:PropertyGridLib.Controls;assembly=PropertyGridLib"
        xmlns:models="clr-namespace:PropertyGridDemo.Models"
        Title="控件独立使用演示" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <models:DemoFormulaTreeProvider x:Key="demoProvider"/>
    </Window.Resources>

    <Grid Margin="16">
        <TabControl>
            <!-- ==================== Tab1: 集合编辑器内联 ==================== -->
            <TabItem Header="集合编辑器内联">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="选择演示类型：" VerticalAlignment="Center" Margin="0,0,12,0"
                                   FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="List&lt;string&gt;" Padding="14,6" Margin="0,0,8,0"
                                Click="ShowStringList_Click"/>
                        <Button Content="List&lt;int&gt;" Padding="14,6" Margin="0,0,8,0"
                                Click="ShowIntList_Click"/>
                        <Button Content="List&lt;SampleObject&gt;" Padding="14,6"
                                Click="ShowObjectList_Click"/>
                    </StackPanel>

                    <controls:PropertyGrid x:Name="collectionPropertyGrid"
                                           Grid.Row="1"
                                           ShowDescription="True"
                                           ShowSearchBar="True"/>
                </Grid>
            </TabItem>

            <!-- ==================== Tab: 字典编辑器 ==================== -->
            <TabItem Header="字典编辑器内联">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="选择演示类型：" VerticalAlignment="Center" Margin="0,0,12,0"
                                   FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="Dictionary&lt;string,int&gt;" Padding="14,6" Margin="0,0,8,8"
                                Click="ShowStringIntDict_Click"/>
                        <Button Content="复杂值 Dictionary&lt;string,SampleObject2&gt;" Padding="14,6" Margin="0,0,8,8"
                                Click="ShowComplexValueDict_Click"/>
                        <Button Content="复杂键 Dictionary&lt;ServerEndpoint,string&gt;" Padding="14,6" Margin="0,0,8,8"
                                Click="ShowComplexKeyDict_Click"/>
                        <Button Content="键值都是对象（左右各 50%）" Padding="14,6" Margin="0,0,8,8"
                                Click="ShowBothComplexDict_Click"/>
                    </WrapPanel>

                    <controls:PropertyGrid x:Name="dictionaryPropertyGrid"
                                           Grid.Row="1"
                                           ShowDescription="True"
                                           ShowSearchBar="True"/>
                </Grid>
            </TabItem>

            <!-- ==================== Tab2: FormulaBindingControl 独立使用 ==================== -->
            <TabItem Header="公式绑定控件独立使用">
                <Grid Margin="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="FormulaBindingControl 可脱离 PropertyGrid 独立使用，通过 FormulaTreeProvider 或 TreeItemsSource 设置树数据"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- 方式一：通过 FormulaTreeProvider -->
                    <Border Grid.Row="1" Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="方式一：FormulaTreeProvider（推荐）" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="设置 FormulaTreeProvider 属性，控件自动调用 GetFormulaTree() 获取树节点"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="公式：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:FormulaBindingControl x:Name="formulaControl1"
                                                             Grid.Column="1"
                                                             FormulaTreeProvider="{StaticResource demoProvider}"
                                                             FormulaString="{Binding Formula1, Mode=TwoWay}"
                                                             Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 方式二：通过 TreeItemsSource -->
                    <Border Grid.Row="2" Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="方式二：TreeItemsSource（直接绑定树数据）" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="直接设置 TreeItemsSource 为 FormulaTreeNode 集合，无需 Provider"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="公式：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:FormulaBindingControl x:Name="formulaControl2"
                                                             Grid.Column="1"
                                                             TreeItemsSource="{Binding DirectTreeNodes}"
                                                             FormulaString="{Binding Formula2, Mode=TwoWay}"
                                                             Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 当前公式值显示 -->
                    <Border Grid.Row="3" Background="{DynamicResource RegionBrush}"
                            CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="当前公式值（实时绑定）" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="formulaValuesText"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

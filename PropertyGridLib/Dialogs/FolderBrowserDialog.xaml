<hc:Window x:Class="PropertyGridLib.Dialogs.FolderBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:PropertyGridLib.Localization"
        xmlns:conv="clr-namespace:PropertyGridLib.Converters"
        Title="{Binding Title}" Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource RegionBrush}">
    <hc:Window.Resources>
        <!-- 不合并 HandyControl 主题字典，继承应用级资源以跟随宿主换肤 -->
        <local:LocalizationProxy x:Key="Localization"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </hc:Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 描述文本 -->
        <TextBlock Grid.Row="0" Text="{Binding Description}" 
                   Margin="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>

        <!-- 文件夹树形视图 -->
        <Border Grid.Row="1" Margin="10,0,10,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TreeView x:Name="FolderTreeView" 
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Background="{DynamicResource RegionBrush}"
                      BorderThickness="0"
                      SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <!-- 选中/悬停背景跟随主题 -->
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="2"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                        <StackPanel Orientation="Horizontal">
                            <!-- 文件夹图标(Path,颜色跟主题走) -->
                            <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" 
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- 选中的路径显示 -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" 
                       Text="{Binding Source={StaticResource Localization}, Path=[SelectedPath]}" 
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" x:Name="SelectedPathTextBox" 
                     IsReadOnly="False"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     Background="{DynamicResource RegionBrush}"
                     VerticalAlignment="Center"
                     TextChanged="SelectedPathTextBox_TextChanged"/>
        </Grid>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="10">
            <Button Content="{Binding Source={StaticResource Localization}, Path=[OK]}" 
                    Width="80" Height="30" 
                    Margin="0,0,10,0"
                    Click="OkButton_Click" 
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}"/>
            <Button Content="{Binding Source={StaticResource Localization}, Path=[Cancel]}" 
                    Width="80" Height="30" 
                    Click="CancelButton_Click" 
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</hc:Window>

<hc:Window x:Class="PropertyGridLib.Dialogs.SimpleCollectionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:PropertyGridLib.Converters"
        xmlns:loc="clr-namespace:PropertyGridLib.Localization"
        x:Name="DlgRoot"
        Title="{loc:Localized EditCollectionTitle}" Height="500" Width="480"
        WindowStartupLocation="CenterOwner">
    <hc:Window.Resources>
        <!-- 同 CollectionEditorDialog：不合并主题字典，继承应用级资源以跟随宿主换肤 -->
        <conv:FontSizeOffsetConverter x:Key="FontSizeOffset"/>
    </hc:Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 列表（字号继承窗口 → 跟随 PropertyGrid.GlobalFontSize） -->
        <ListBox x:Name="ItemsList" Grid.Row="0" Margin="0,0,0,10"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="5,3"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 输入框（全局字号 +4，与原视觉层级一致） -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Margin="0,0,5,0"
                     FontSize="{Binding ElementName=DlgRoot, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=4}"
                     hc:InfoElement.Placeholder="{loc:Localized InputPlaceholder}"
                     KeyDown="InputBox_KeyDown"/>
            <Button x:Name="AddButton" Grid.Column="1" Height="35" Content="{loc:Localized Add}" MinWidth="80" Width="auto" Click="AddButton_Click" Style="{StaticResource ButtonSuccess}"/>
        </Grid>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteButton" Content="{loc:Localized Remove}" Height="35" MinWidth="80" Width="auto" Margin="0,0,5,0" Click="DeleteButton_Click" Style="{StaticResource ButtonDanger}"/>
            <Button x:Name="MoveUpButton" Content="{loc:Localized MoveUp}" Height="35" MinWidth="80" Width="auto" Margin="0,0,5,0" Click="MoveUpButton_Click"/>
            <Button x:Name="MoveDownButton" Content="{loc:Localized MoveDown}" Height="35" MinWidth="80" Width="auto" Margin="0,0,5,0" Click="MoveDownButton_Click"/>
            <Button x:Name="OkButton" Content="{loc:Localized OK}" MinWidth="80" Width="auto" Height="35" Margin="0,0,5,0"
                    Style="{StaticResource ButtonPrimary}" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="{loc:Localized Cancel}" Height="35" MinWidth="80" Width="auto" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>

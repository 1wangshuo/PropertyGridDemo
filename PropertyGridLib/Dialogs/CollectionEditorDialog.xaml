<hc:Window x:Class="PropertyGridLib.Dialogs.CollectionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:PropertyGridLib.Converters"
        xmlns:controls="clr-namespace:PropertyGridLib"
        xmlns:loc="clr-namespace:PropertyGridLib.Localization"
        x:Name="DlgRoot"
        Title="{loc:Localized CollectionEditorTitle}" Height="580" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">
    <hc:Window.Resources>
        <!-- 注意：不再合并 HandyControl 主题字典（官方包无 hc:ThemeResources，且窗口级合并的
             Theme 实例独立于应用级，会导致宿主切主题时弹窗不跟随）。改为继承应用级资源：
             宿主 App 合并 SkinDefault/Theme 后，此处所有 DynamicResource 画刷自动联动换肤。 -->
        <conv:FontSizeOffsetConverter x:Key="FontSizeOffset"/>
    </hc:Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容区：左边列表 + 右边属性 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：集合项列表 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <!-- 列表标题（全局字号 +2，保持标题层级） -->
                    <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"  Padding="10,8" CornerRadius="4,4,0,0">
                        <TextBlock FontWeight="Bold"
                                   FontSize="{Binding ElementName=DlgRoot, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=2}"
                                   Text="{loc:Localized CollectionItems}"/>
                    </Border>

                    <!-- 列表（字号继承窗口 → 跟随 PropertyGrid.GlobalFontSize） -->
                    <ListBox x:Name="ItemsListBox" Grid.Row="1"
                             SelectionChanged="ItemsListBox_SelectionChanged"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5,3">
                                    <TextBlock Text="{Binding Index, StringFormat=[{0}]}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <hc:UniformSpacingPanel Width="auto" Grid.Row="2" Spacing="5">
                        <Button x:Name="AddButton" Content="{loc:Localized Add}" Height="35" MinWidth="80" Width="auto" Margin="5,0,0,0" Click="AddButton_Click" Style="{StaticResource ButtonPrimary}"/>
                        <Button x:Name="CopyButton" Content="{loc:Localized Copy}" Height="35" MinWidth="80" Width="auto" Margin="0,0" Click="CopyButton_Click"/>
                        <Button x:Name="RemoveButton" Content="{loc:Localized Remove}" Height="35" MinWidth="80" Width="auto" Margin="0,0" Click="RemoveButton_Click" Style="{StaticResource ButtonDanger}"/>
                    </hc:UniformSpacingPanel>
                </Grid>
            </Border>

            <hc:UniformSpacingPanel Grid.Column="1" Spacing="25" Orientation="Vertical">
                <Button x:Name="MoveUpButton" Content="↑" Width="50" Height="45" Margin="5"
                        FontSize="{Binding ElementName=DlgRoot, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=4}"
                        Click="MoveUpButton_Click"/>
                <Button x:Name="MoveDownButton" Content="↓" Width="50" Height="45" Margin="5"
                        FontSize="{Binding ElementName=DlgRoot, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=4}"
                        Click="MoveDownButton_Click"/>
            </hc:UniformSpacingPanel>

            <!-- 右侧：属性编辑器 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 属性标题（全局字号 +2） -->
                    <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}" Padding="10,8" CornerRadius="4,4,0,0">
                        <TextBlock FontWeight="Bold"
                                   FontSize="{Binding ElementName=DlgRoot, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=2}"
                                   Text="{loc:Localized Properties}"/>
                    </Border>

                    <!-- PropertyGrid -->
                    <controls:PropertyGrid x:Name="ItemPropertyGrid" Grid.Row="1"
                                           ShowSearchBar="True"
                                           ShowDescription="True"
                                           Margin="0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮区 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"  Margin="0,15,0,0">

            <Separator Width="20" Margin="10,0" Background="Transparent"/>
            <Button x:Name="OkButton" Height="35" Content="{loc:Localized OK}"  MinWidth="80" Width="auto" Margin="5,0" Click="OkButton_Click" Style="{StaticResource ButtonPrimary}"/>
            <Button x:Name="CancelButton" Height="35" Content="{loc:Localized Cancel}" MinWidth="80" Width="auto" Margin="5,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>

<UserControl x:Class="PropertyGridLib.Controls.CollectionEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:PropertyGridLib.Converters"
        xmlns:controls="clr-namespace:PropertyGridLib"
        xmlns:loc="clr-namespace:PropertyGridLib.Localization"
        x:Name="Root">
    <UserControl.Resources>
        <conv:FontSizeOffsetConverter x:Key="FontSizeOffset"/>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：集合项列表 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}" Padding="10,8" CornerRadius="4,4,0,0">
                        <TextBlock FontWeight="Bold"
                                   FontSize="{Binding ElementName=Root, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=2}"
                                   Text="{loc:Localized CollectionItems}"/>
                    </Border>

                    <ListBox x:Name="ItemsListBox" Grid.Row="1"
                             SelectionChanged="ItemsListBox_SelectionChanged"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5,3">
                                    <TextBlock Text="{Binding Index, StringFormat=[{0}]}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <hc:UniformSpacingPanel Width="auto" Grid.Row="2" Spacing="5">
                        <Button Content="{loc:Localized Add}" Height="35" MinWidth="80" Width="auto" Margin="5,0,0,0" Click="AddButton_Click" Style="{StaticResource ButtonPrimary}"/>
                        <Button Content="{loc:Localized Copy}" Height="35" MinWidth="80" Width="auto" Margin="0,0" Click="CopyButton_Click"/>
                        <Button Content="{loc:Localized Remove}" Height="35" MinWidth="80" Width="auto" Margin="0,0" Click="RemoveButton_Click" Style="{StaticResource ButtonDanger}"/>
                    </hc:UniformSpacingPanel>
                </Grid>
            </Border>

            <hc:UniformSpacingPanel Grid.Column="1" Spacing="25" Orientation="Vertical">
                <Button Content="&#x2191;" Width="50" Height="45" Margin="5"
                        FontSize="{Binding ElementName=Root, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=4}"
                        Click="MoveUpButton_Click"/>
                <Button Content="&#x2193;" Width="50" Height="45" Margin="5"
                        FontSize="{Binding ElementName=Root, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=4}"
                        Click="MoveDownButton_Click"/>
            </hc:UniformSpacingPanel>

            <!-- 右侧：属性编辑器 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}" Padding="10,8" CornerRadius="4,4,0,0">
                        <TextBlock FontWeight="Bold"
                                   FontSize="{Binding ElementName=Root, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=2}"
                                   Text="{loc:Localized Properties}"/>
                    </Border>

                    <controls:PropertyGrid x:Name="ItemPropertyGrid" Grid.Row="1"
                                           ShowSearchBar="True"
                                           ShowDescription="True"
                                           Margin="0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

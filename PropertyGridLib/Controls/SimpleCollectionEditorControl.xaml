<UserControl x:Class="PropertyGridLib.Controls.SimpleCollectionEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:PropertyGridLib.Converters"
        xmlns:loc="clr-namespace:PropertyGridLib.Localization"
        x:Name="Root">
    <UserControl.Resources>
        <conv:FontSizeOffsetConverter x:Key="FontSizeOffset"/>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 列表 -->
        <ListBox x:Name="ItemsList" Grid.Row="0" Margin="0,0,0,10"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="5,3"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 输入框 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Margin="0,0,5,0"
                     FontSize="{Binding ElementName=Root, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=4}"
                     hc:InfoElement.Placeholder="{loc:Localized InputPlaceholder}"
                     KeyDown="InputBox_KeyDown"/>
            <Button Grid.Column="1" Height="35" Content="{loc:Localized Add}" MinWidth="80" Width="auto"
                    Click="AddButton_Click" Style="{StaticResource ButtonSuccess}"/>
        </Grid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Localized Remove}" Height="35" MinWidth="80" Width="auto"
                    Margin="0,0,5,0" Click="DeleteButton_Click" Style="{StaticResource ButtonDanger}"/>
            <Button Content="{loc:Localized MoveUp}" Height="35" MinWidth="80" Width="auto"
                    Margin="0,0,5,0" Click="MoveUpButton_Click"/>
            <Button Content="{loc:Localized MoveDown}" Height="35" MinWidth="80" Width="auto"
                    Margin="0,0,5,0" Click="MoveDownButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>

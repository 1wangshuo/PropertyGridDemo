<UserControl x:Class="PropertyGridLib.Controls.DictionaryEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:conv="clr-namespace:PropertyGridLib.Converters"
        xmlns:controls="clr-namespace:PropertyGridLib"
        xmlns:loc="clr-namespace:PropertyGridLib.Localization"
        x:Name="Root">
    <UserControl.Resources>
        <conv:FontSizeOffsetConverter x:Key="FontSizeOffset"/>
    </UserControl.Resources>

    <Grid Margin="4">
        <!-- 完整编辑面板（Compact=false 时显示）；与下方紧凑条互斥 -->
        <Grid x:Name="PanelHost">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：字典条目列表 -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}" Padding="10,8" CornerRadius="4,4,0,0">
                    <TextBlock FontWeight="Bold"
                               FontSize="{Binding ElementName=Root, Path=FontSize, Converter={StaticResource FontSizeOffset}, ConverterParameter=2}"
                               Text="{loc:Localized DictEntries}"/>
                </Border>

                <ListBox x:Name="EntriesListBox" Grid.Row="1"
                         SelectionChanged="EntriesListBox_SelectionChanged"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MaxWidth="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding KeyDisplay}" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="="/>
                                <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}"
                                           TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <hc:UniformSpacingPanel Grid.Row="2" Spacing="5" Margin="5">
                    <Button Content="{loc:Localized Add}" Height="35" MinWidth="70" Width="auto"
                            Click="AddButton_Click" Style="{StaticResource ButtonPrimary}"/>
                    <Button Content="{loc:Localized Remove}" Height="35" MinWidth="70" Width="auto"
                            Click="RemoveButton_Click" Style="{StaticResource ButtonDanger}"/>
                </hc:UniformSpacingPanel>
            </Grid>
        </Border>

        <!-- 右侧：键值编辑（键、值均为对象时左右各占 50%，否则上下堆叠；由 ApplyLayout 切换） -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid x:Name="EditorsHost" Margin="10">
                <!-- 键区 -->
                <Grid x:Name="KeySection">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{loc:Localized DictKey}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="KeyInputBox"
                                 VerticalAlignment="Top"
                                 VerticalContentAlignment="Center"
                                 LostFocus="KeyInputBox_LostFocus"/>
                        <Border x:Name="KeyPropertyGridHost"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Visibility="Collapsed">
                            <controls:PropertyGrid x:Name="KeyPropertyGrid"
                                                   ShowHeader="False"
                                                   ShowSearchBar="True"
                                                   ShowDescription="True"/>
                        </Border>
                        <!-- 嵌套字典/列表：显示摘要 + "..."按钮，点击弹窗编辑，避免内联导致 UI 过长 -->
                        <Grid x:Name="KeySummaryHost" Visibility="Collapsed" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KeySummaryText" Grid.Column="0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="KeyEditButton" Grid.Column="1" Content="..." MinWidth="30" Margin="4,0,0,0"
                                    Click="KeyEditButton_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 值区 -->
                <Grid x:Name="ValueSection">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{loc:Localized DictValue}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="ValueInputBox"
                                 VerticalAlignment="Top"
                                 VerticalContentAlignment="Center"
                                 LostFocus="ValueInputBox_LostFocus"/>
                        <Border x:Name="ValuePropertyGridHost"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Visibility="Collapsed">
                            <controls:PropertyGrid x:Name="ValuePropertyGrid"
                                                   ShowHeader="False"
                                                   ShowSearchBar="True"
                                                   ShowDescription="True"/>
                        </Border>
                        <!-- 嵌套字典/列表：显示摘要 + "..."按钮，点击弹窗编辑，避免内联导致 UI 过长 -->
                        <Grid x:Name="ValueSummaryHost" Visibility="Collapsed" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ValueSummaryText" Grid.Column="0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="ValueEditButton" Grid.Column="1" Content="..." MinWidth="30" Margin="4,0,0,0"
                                    Click="ValueEditButton_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- 紧凑形态（Compact=true）：一条「值框 + ...」，点 ... 打开字典编辑器弹窗 -->
        <Grid x:Name="CompactBar" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="8,0" MinHeight="30"
                    SnapsToDevicePixels="True">
                <TextBlock x:Name="CompactSummary"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>
            <Button Grid.Column="1" Content="..." MinWidth="30" Margin="4,0,0,0"
                    Click="CompactEdit_Click"
                    ToolTip="{loc:Localized OpenDictionaryEditor}"/>
        </Grid>
    </Grid>
</UserControl>

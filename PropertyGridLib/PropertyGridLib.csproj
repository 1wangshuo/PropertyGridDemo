<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netcoreapp3.0;netcoreapp3.1;net6.0-windows;net7.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>PropertyGridLib</RootNamespace>
    <AssemblyName>PropertyGridLib</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    
    <!-- NuGet 包配置 -->
    <PackageId>PropertyGridLib</PackageId>
    <Version>1.6.5</Version>
    <AssemblyVersion>1.6.5.0</AssemblyVersion>
    <FileVersion>1.6.5.0</FileVersion>
    <Authors>WangShuo</Authors>
    <Company>WangShuo</Company>
    <Product>PropertyGridLib</Product>
    <Copyright>Copyright © 2026 WangShuo. All rights reserved.</Copyright>
    <Trademark>WangShuo</Trademark>
    <Description>WPF 属性网格控件库（基于 HandyControl）。PropertyGrid 提供经典两栏与紧凑单行两种排布、分类卡片、搜索与多语言；PropertyGridPro 提供卡片式与选项页表单式排布。内置集合/字典/公式绑定/颜色/图片/链接等编辑器，支持 [Highlight] 关键属性标记与 [EditorChrome] 编辑器装饰开关。适用于 .NET Framework 4.8 与 .NET 6/7/8/10 (Windows)。</Description>
    <PackageTags>WPF;PropertyGrid;PropertyGridPro;Editor;Controls;Button;Dictionary;Collection;Formula;MultiSelect;ToggleSwitch;Localization;EventPicker;Events;HandyControl;TypeConverter;NETCoreApp3;NET6;NET7;NET8;NET10</PackageTags>
    <PackageReleaseNotes>1.6.5
· 分类改为卡片式（基础网格、事件页与 Pro 统一），标题跟随主题色
· Pro 新增表单式排布（Layout=Section）与底部描述区（可拖动分隔条调整高度）
· 新增链接自动识别：字符串值为 http/https/ftp/mailto 时渲染为可点击文本
· 新增 [Highlight] 关键属性标记：基础网格圆点 / 表单式竖线 / 卡片描边
· 新增 [EditorChrome] 编辑器装饰开关：隐藏或改名重置按钮、单独控制类型提示
· 新增图片预览编辑器，支持 ImageSource、图像文件字节流与自定义图像类型（如 GenImage）
· 支持隐藏搜索框、展开折叠按钮与分类头（ShowSearchBar / ShowExpandCollapse / ShowCategoryHeaders）
· 同类型切换 SelectedObject 改为原地换绑，重建耗时由 250ms 级降至个位数毫秒</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/1wangshuo/PropertyGridDemo</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- 包输出统一到解决方案根 nuget\。
         不能只用 $(SolutionDir)：单独对本工程执行 dotnet pack/build 时该属性为空，
         包会落到 PropertyGridLib\nuget\ 造成「两个地方都有包、分不清哪个最新」。
         这里以工程文件位置为准推导，任何方式打包都输出到同一目录。 -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\nuget\</PackageOutputPath>
    <InformationalVersion>1.6.5</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 官方 HandyControl（非 fork）。主题资源不再由库内窗口自行合并，
         弹窗继承应用级资源；主题切换由宿主通过 Theme.Skin / ThemeManager 完成 -->
    <PackageReference Include="HandyControl" Version="3.5.1" />
    
    <!-- System.Text.Json 使用灵活版本范围，允许宿主项目使用更高版本 -->
    <!-- .NET 6/7/8 已内置 System.Text.Json，此引用仅为 net48 提供支持 -->
    <PackageReference Include="System.Text.Json" Version="6.0.0" Condition="'$(TargetFramework)' == 'net48'" />

    <!-- Costura.Fody：把 HandyControl / System.Text.Json 等依赖 DLL 嵌入合并到 PropertyGridLib 里，
         宿主只需引用一个 DLL，无需额外附带 HandyControl.dll -->
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>

            <!-- 每组最后一行收口：下边 + 下圆角 -->
            <DataTrigger Binding="{Binding IsGroupLast}" Value="True">
                <Setter TargetName="RowCard" Property="BorderThickness" Value="1,0,1,1"/>
                <Setter TargetName="RowCard" Property="CornerRadius" Value="0,0,4,4"/>
            </DataTrigger>
            <!-- 单行组：四角圆角 + 完整边框 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsGroupFirst}" Value="True"/>
                    <Condition Binding="{Binding IsGroupLast}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="RowCard" Property="BorderThickness" Value="1"/>
                <Setter TargetName="RowCard" Property="CornerRadius" Value="4"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 隐式模板：子 ItemsControl 自动使用此模板渲染 PropertyItem，实现无限递归 -->
    <!--
        隐式模板：根据 PropertyGrid.TitlePlacement 把行路由到「标题在上」或「标题在左」模板。
        用 ContentControl + DataTrigger 而不是直接设置 ItemsControl.ItemTemplate：
        CategoryTemplate 等多处都会创建 PropertyItem 列表，
        统一走隐式模板才能一处切换、全局生效。
        ContentTemplate 明确指向 StaticResource，不会回退到隐式模板自身，不会递归。
    -->
    <DataTemplate DataType="{x:Type local:PropertyItem}">
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource PropertyRowTemplate}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TitlePlacement, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}}" Value="Left">
                            <Setter Property="ContentTemplate" Value="{StaticResource PropertyRowTemplate_Left}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DataTemplate>

    <!-- ========== 分类模板 ========== -->
    <DataTemplate x:Key="CategoryTemplate" DataType="{x:Type local:PropertyCategory}">
        <Expander IsExpanded="{Binding IsExpanded}"
                  Header="{Binding Name}"
                  FontWeight="{Binding CategoryFontWeight, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}}"
                  Foreground="{DynamicResource PrimaryBrush}"
                  Margin="0,4,0,0">
            <Expander.HeaderTemplate>
                <DataTemplate>
                    <!-- 字号与粗细均绑定到 PropertyGrid，宿主可统一控制 -->
                    <TextBlock Text="{Binding}" 
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}" 
                           FontWeight="{Binding CategoryFontWeight, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}}"
                           Foreground="{DynamicResource PrimaryBrush}" />
                </DataTemplate>
            </Expander.HeaderTemplate>
            <!-- 行模板走隐式模板（根据 PropertyGrid.TitlePlacement 自动切换 Top/Left 布局） -->
            <ItemsControl ItemsSource="{Binding Items}"
                          FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"/>
        </Expander>
    </DataTemplate>

    <!-- ========== 1.4.0 事件页模板（EventItem 行 / EventCategory 分组 / EventPicker / EventEditorControl） ========== -->

    <!-- 事件行：名称（上） + 行内编辑器（下） -->
    <DataTemplate x:Key="EventItemRowTemplate" DataType="{x:Type local:EventItem}">
        <!-- 与属性页同款卡片：每行是卡片的一段（左右描边），末行（IsGroupLast）补下边与下圆角。
             底色必须和属性行一致用 SecondaryRegionBrush（浅灰）—— 之前用 RegionBrush（白），
             白卡片浮在灰底上，观感与属性页相反，还被误认为"底部空了一块"。 -->
        <Border x:Name="EventRowCard"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,1,0"
                Margin="0"
                SnapsToDevicePixels="True">
        <Grid Margin="0" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 事件名（上方，样式与属性名对齐） -->
            <TextBlock Grid.Row="0" Text="{Binding DisplayName}" Margin="8,4,4,2"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       ToolTip="{Binding Description}"
                       VerticalAlignment="Center"/>

            <!-- 处理方法名编辑器 + ⚡（下方） -->
            <Grid Grid.Row="1" Margin="8,2,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <local:EventEditorControl Grid.Column="0"/>

                <!-- 已绑定标记（未绑定时隐藏，不留白） -->
                <Border Grid.Column="1" Width="20" Height="20" Margin="4,0,0,0"
                        CornerRadius="3"
                        Background="{DynamicResource SuccessBrush}"
                        Visibility="{Binding HasHandler, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding HandlerName}">
                    <TextBlock Text="⚡" FontSize="10"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
        </Border>
        <DataTemplate.Triggers>
            <!-- 每组首行：上边 + 上圆角 -->
            <DataTrigger Binding="{Binding IsGroupFirst}" Value="True">
                <Setter TargetName="EventRowCard" Property="BorderThickness" Value="1,1,1,0"/>
                <Setter TargetName="EventRowCard" Property="CornerRadius" Value="4,4,0,0"/>
            </DataTrigger>
            <!-- 每组最后一行收口：补下边 + 下圆角，整组事件成为一张完整卡片 -->
            <DataTrigger Binding="{Binding IsGroupLast}" Value="True">
                <Setter TargetName="EventRowCard" Property="BorderThickness" Value="1,0,1,1"/>
                <Setter TargetName="EventRowCard" Property="CornerRadius" Value="0,0,4,4"/>
            </DataTrigger>
            <!-- 单行组：四角圆角 + 完整边框 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsGroupFirst}" Value="True"/>
                    <Condition Binding="{Binding IsGroupLast}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="EventRowCard" Property="BorderThickness" Value="1"/>
                <Setter TargetName="EventRowCard" Property="CornerRadius" Value="4"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 事件分类分组：与属性 CategoryTemplate 同风格 -->
    <DataTemplate x:Key="EventCategoryTemplate" DataType="{x:Type local:EventCategory}">
        <Expander IsExpanded="True"
                  Header="{Binding Name}"
                  FontWeight="Bold"
                  Foreground="{DynamicResource PrimaryBrush}"
                  Margin="0,4,0,0">
            <Expander.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </DataTemplate>
            </Expander.HeaderTemplate>
            <ItemsControl ItemsSource="{Binding Items}"
                          FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"
                          ItemTemplate="{StaticResource EventItemRowTemplate}"/>
        </Expander>
    </DataTemplate>

    <!-- EventPicker 平铺列表的分类头：可折叠（与属性页分类头同款手法 ——
         分类头本身只是平铺列表中的一行 Expander，折叠状态经 TwoWay 绑定回 EventCategory.IsExpanded，
         由 EventPicker 重建一次平铺行；行内不嵌套任何内容，所以虚拟化不受影响）。 -->
    <DataTemplate x:Key="EventFlatCategoryHeaderTemplate">
        <!-- 与属性页分类头同款外观：透明底 + 主题色竖条 + 蓝字，右侧一个折叠箭头。
             之前用 HandyControl 的 Expander，它的模板自带灰底块和边框，
             跟普通属性页的分类头完全不同层级感（demo 反馈"折叠容器用的不对"）。 -->
        <ToggleButton x:Name="HeaderToggle"
                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      Focusable="False"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderRoot" Background="Transparent" Padding="4,9,4,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,8,0"
                                        Background="{DynamicResource PrimaryBrush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"
                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:EventPicker}}"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Path x:Name="Chevron" Grid.Column="1"
                                  Data="M7,10 L12,5 L17,10"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6"
                                  Width="12" Height="8" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chevron" Property="Data" Value="M7,5 L12,10 L17,5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderRoot" Property="Background" Value="{DynamicResource ThirdlyRegionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="">
                <Setter TargetName="HeaderToggle" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 平铺行模板选择器：StaticResource 只能向前引用，必须声明在 EventPicker 样式之前 -->
    <local:EventFlatRowTemplateSelector x:Key="EventFlatRowTemplateSelector"
                                        CategoryTemplate="{StaticResource EventFlatCategoryHeaderTemplate}"
                                        ItemTemplate="{StaticResource EventItemRowTemplate}"/>

    <!-- EventPicker：搜索 + 平铺虚拟化事件列表（与 PropertyGrid 同款「压平 + 虚拟化」：
         Button 有 100+ 事件，嵌套 Expander 全量生成每行 HC TextBox+按钮，首次打开明显卡顿；
         平铺后 VirtualizingStackPanel 只生成视口内的行） -->
    <Style TargetType="{x:Type local:EventPicker}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:EventPicker}">
                    <!-- 白底与属性页一致：以前控件本身透明，被外层灰底衬得像"整块反色" -->
                    <Grid Background="{DynamicResource RegionBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <!-- 底部描述栏（选中事件带说明时才有内容，否则整条不占位） -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <hc:SearchBar Grid.Row="0"
                                      Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                      hc:InfoElement.Placeholder="{loc:Localized EventSearchPlaceholder}"
                                      Margin="8,8,8,4"/>

                        <!-- CanContentScroll=True 是项滚动虚拟化的必要前提；
                             滚动位置由代码侧恢复（EventPicker.RebuildRows），不用外置 ScrollViewer -->
                        <!-- 列表：ScrollViewer 必须放在 ItemsControl 自己的 ControlTemplate 内、
                             紧邻 ItemsPresenter —— 外置 ScrollViewer 包 ItemsControl 时 VSP 接管不了
                             IScrollInfo，会退化为像素滚动全量生成（实测 111/114 行全生成） -->
                        <!-- IsVirtualizing 不在这里写死：由 EventPicker.RebuildRows 按行数自适应
                             （少行全量精确布局，避免虚拟化估算虚大导致底部空白）。 -->
                        <ItemsControl Grid.Row="1" x:Name="PART_ItemsControl"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ItemTemplateSelector="{StaticResource EventFlatRowTemplateSelector}">
                            <!-- 项容器压掉默认间距：否则每行灰卡片之间会露出白缝，
                                 普通属性页是连续灰底卡片，两者观感对不上（demo 对比反馈） -->
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <!-- 稳定滚动条（与属性列表同一套：拇指常显、hover 只变色） -->
                                    <ScrollViewer x:Name="PART_ScrollViewer"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  behaviors:TouchScroll.IsEnabled="True"
                                                  Padding="0,0,0,8">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource StableScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 底部描述栏：与属性页描述栏同款排布（标题 + 说明文字）。
                             只在「选中的事件确有说明」时出现 —— 事件无 [Description] 时不占任何高度，
                             不像属性页那样即使没有说明也留一条空栏。 -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8,6">
                            <!-- 默认 Collapsed，只有明确 True 才显示：
                                 直接绑 HasDescription 时，初始 SelectedEvent=null 会让
                                 绑定路径断开 → Visibility 保持默认值（Visible）→
                                 一打开底部就多一条空灰条，点一下才消失（demo 实测）。 -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedEvent.HasDescription, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedEvent.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedEvent.Description, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-1}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EventEditorControl：处理方法名输入 + ⚡ 按钮 -->
    <Style TargetType="{x:Type local:EventEditorControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:EventEditorControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 绑控件自身 DP（TemplatedParent）而非 DataContext：这样脱离 PropertyGrid/EventItem
                             也能独立使用；网格内联时由 EventEditorControl.SyncFromItem 把 EventItem 值灌进 DP。 -->
                        <hc:TextBox x:Name="PART_HandlerNameBox" Grid.Column="0"
                                    Text="{Binding HandlerName, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    hc:InfoElement.Placeholder="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Button x:Name="PART_EditButton" Grid.Column="1"
                                Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                Content="⚡" FontSize="11"
                                ToolTip="{loc:Localized EditHandler}"
                                Style="{StaticResource IconButtonStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== PropertyGrid 默认样式 ========== -->
    <Style TargetType="{x:Type pg:PropertyGrid}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type pg:PropertyGrid}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid
                            TextElement.FontFamily="{Binding FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                            TextElement.FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 集合编辑器宿主（集合模式下显示，覆盖整个区域） -->
                            <ContentControl x:Name="PART_CollectionEditorHost" Grid.Row="1"
                                            Visibility="Collapsed"/>

                            <!-- 正常属性显示区域 -->
                            <Grid x:Name="PART_NormalHost" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <!-- 描述栏行：固定 80 可拖；ShowDescription=false 时 cs 把行高压 0，
                                         否则内容 Collapsed 行高不动，底部留一条空白 -->
                                    <RowDefinition x:Name="PART_DescriptionRow" Height="80" MinHeight="40" MaxHeight="300"/>
                                </Grid.RowDefinitions>

                                <!-- 展开/折叠 + 搜索框（属性页内部；事件页激活时随属性页折叠，功能不变）
                                     两者各有开关：ShowExpandCollapse / ShowSearchBar，
                                     宿主只要纯属性表时可以把整行工具条都收掉。 -->
                                <DockPanel Grid.Row="0" LastChildFill="True">
                                    <!-- 顶部标题（如「属性」）：Dock=Top 落在工具条上方；
                                         文本与显隐由 cs 的 ApplyHeader 统一接管：
                                         Header=null → 按当前语言取默认标题；Header="" → 隐藏；
                                         ShowHeader=false 时同样收起（PART_HeaderTitle） -->
                                    <TextBlock DockPanel.Dock="Top"
                                               x:Name="PART_HeaderTitle"
                                               Margin="12,8,12,2"
                                               FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FontSizeOffset}, ConverterParameter=2}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <hc:ButtonGroup VerticalAlignment="Center"
                                                    Visibility="{Binding ShowExpandCollapse, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                                        <RadioButton x:Name="PART_ExpandRadio" Content="{loc:Localized ExpandAll}"
                                                     GroupName="ExpandMode" Margin="0,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        
                                        <RadioButton x:Name="PART_CollapseRadio" Content="{loc:Localized CollapseAll}"
                                                     GroupName="ExpandMode"
                                                     VerticalAlignment="Center"/>
                                    </hc:ButtonGroup>
                                    <hc:SearchBar x:Name="PART_SearchBox"
                                             Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                             hc:InfoElement.Placeholder="{loc:Localized SearchPlaceholder}"
                                             Visibility="{Binding ShowSearchBar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"
                                             Margin="8"/>
                                </DockPanel>

                                <!-- 属性列表 + 加载层（1.4.0：加载指示用静态文本代替 LoadingCircle ——
                                     动画时钟在快速显隐的元素上持续 tick 是 clr 闪退的根源，静态化后无时钟无竞态）。
                                     顶部 2px：无分类头时靠首行卡片自身的上边距/圆角留呼吸，
                                     不再叠加 8px（有分类头时距离过大的反馈）。 -->
                                <Grid Grid.Row="1" Margin="0,2,0,0">
                                    <!-- 虚拟化（Recycling）+ 项滚动（CanContentScroll=True）：只有项滚动下
                                         VirtualizingStackPanel 才真正虚拟化（只生成可见行，实测 Realized≈5，
                                         渲染 <30ms）。像素滚动（ScrollUnit=Pixel）虽滚动条精确，但 WPF 必须
                                         生成全部容器算 Extent → 95 行全量渲染 ~650ms，切换对象卡顿。
                                         滚动条估算（平均行高）由代码侧"首行预热"修正（见 PropertyGrid.cs
                                         RefreshProperties），因此滚动条依然准确。 -->
                                    <ItemsControl x:Name="PART_ItemsControl"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer x:Name="PART_ScrollViewer"
                                                              CanContentScroll="True"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              behaviors:TouchScroll.IsEnabled="True">
                                                    <ScrollViewer.Resources>
                                                        <!-- 稳定滚动条：拇指常显、hover 只变色（见 StableScrollBar） -->
                                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource StableScrollBar}"/>
                                                    </ScrollViewer.Resources>
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.Resources>
                                            <!-- 扁平列表中的类别头：点击折叠/展开，属性行作为独立项排在它后面。
                                                 类别头保持紧凑（不强制高度）：折叠态无内容，高度=Header 自然高，
                                                 避免类别名下方出现空白。
                                                 HeaderTemplate 的 TextBlock 必须显式绑 FontSize/FontWeight——
                                                 HC 的 Expander 隐式样式给头部定了固定字号，靠继承会卡死在 12
                                                 不随 PropertyGrid.FontSize 缩放（老版 CategoryTemplate 同款绑定）。 -->
                                            <DataTemplate DataType="{x:Type local:PropertyCategory}">
                                                <!-- 分类标题：透明底、浮在卡片上方（HandyControl PropertyGrid 的写法 ——
                                                     标题本身不铺底色，下面的属性行组成一张带描边和圆角的白色卡片）。
                                                     行表按分类扁平化，所以"卡片"由每一行自己的 Border 拼出来，
                                                     末行（IsGroupLast）负责补下边框与下圆角。 -->
                                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                          Header="{Binding Name}"
                                                          FontWeight="{Binding CategoryFontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Foreground="{DynamicResource PrimaryBrush}"
                                                          Background="Transparent"
                                                          Margin="4,6,4,0"
                                                          Padding="2,0,2,2">
                                                    <Expander.HeaderTemplate>
                                                        <DataTemplate>
                                                            <!-- 分类名用主题强调色：与关键属性竖线、链接同一色系 -->
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"
                                                                       FontWeight="{Binding CategoryFontWeight, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}}"
                                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </Expander.HeaderTemplate>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                    </ItemsControl>

                                    <Border Background="{DynamicResource RegionBrush}"
                                            Visibility="{Binding IsLoading, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="..."
                                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- 可拖拽分割条（ShowDescription=false 时随描述栏一起隐藏，由 cs 接管显隐） -->
                                <GridSplitter Grid.Row="2"
                                              x:Name="PART_DescriptionSplitter"
                                              Height="4"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource BorderBrush}"
                                              ResizeBehavior="PreviousAndNext"
                                              ResizeDirection="Rows"
                                              Cursor="SizeNS"/>

                                <!-- 描述栏（可调节高度） -->
                                <Border Grid.Row="3"
                                        x:Name="PART_DescriptionBar"
                                        Background="{DynamicResource SecondaryRegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="8"
                                        Visibility="{Binding SelectedPropertyItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <TextBlock x:Name="PART_DescriptionTitle"
                                                   Text="{Binding SelectedPropertyItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="PART_DescriptionText"
                                                   Text="{Binding SelectedPropertyItem.Description, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-1}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         PropertyGridPro：跟随主题的「参数配置」平铺面板
         配色不自定义任何画刷，直接复用项目 / HandyControl 现有主题键：
           RegionBrush           → 面板底色
           SecondaryRegionBrush  → 行悬停底色
           BorderBrush           → 行分隔线、面板描边
           PrimaryTextBrush      → 标题、属性名
           SecondaryTextBrush    → 说明描述、来源、空状态
           PrimaryBrush          → 强调色（分类竖条、图标按钮、编辑器强调色）
         切换 HandyControl 皮肤（SkinType.Default / Dark）时自动跟随。
         ============================================================ -->

    <!-- ========== PropertyGridPro：单行模板（卡片式：属性名 + 说明 + 值编辑器） ========== -->
    <!-- 排布：每个属性项 = 一张独立圆角卡片（圆角 7px、无阴影、1px 极细描边），
         卡片间留白 10px，卡片内边距 上/下 12、左/右 16；属性名在左上、说明紧随其下，值编辑器统一右对齐；
         行与行之间不再使用 1px 分隔线，改由卡片底色 + 描边 + 留白区分。 -->
    <DataTemplate x:Key="ProPropertyRowTemplate">
        <StackPanel>
            <!-- 分类之间的"缝"：主题色 1px 细线（组首行且非首组显示）。
                 位置就在**分类头文本下方**（组首行卡片上方）——分类头模板本身不画线，
                 全局只有这一处，不会出现"上下各一条"的重复（demo 反馈）。 -->
            <Border Height="1"
                    Margin="16,2,16,2"
                    Background="{DynamicResource PrimaryBrush}"
                    Opacity="0.5"
                    Visibility="{Binding ShowGroupSeparator, Converter={StaticResource BoolToVis}}"/>
            <Border x:Name="ProRowRoot"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="16,16,16,14"
                    Margin="{Binding ProRowMargin}"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 左右两栏：标题列（*）+ 编辑器列（Auto，固定 EditorWidth+按钮宽，贴卡片右缘）。
                                 窗口拉宽时新增空间全部落在两栏之间——标签始终贴卡片左缘、编辑器始终在右。
                                 标题内容显式 HorizontalAlignment=Left + MaxWidth=300：只占自身宽度、
                                 绝不因 Stretch+MaxWidth 的排列差异在标题左侧留出大空隙。
                                 编辑器列必须保持 Auto：此前 *+* 对半分在宽窗口会把编辑器横向拉大、
                                 窄窗口又压到 290（固定 300 宽右对齐后向左溢出被裁——
                                 DatePicker 只剩 "-03-15 00:00:00"、可展开行箭头 ▶ 被裁）。 -->
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：属性名（上）+ 说明（下），均单行省略（老版同款紧凑行），完整内容看 ToolTip。
                             HorizontalAlignment=Left：宽窗口下标题与卡片左缘之间只留卡片自身 Padding，
                             不允许标题被"放"到行中部。 -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" MaxWidth="300">
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProRowDescription"
                                       Text="{Binding Description}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-2}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding Description}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 右：值编辑器（统一右对齐）+ 绑定按钮 + 复位按钮。
                             进入公式绑定后整块隐藏 —— 公式条自己占这一列，不再需要底板遮挡。 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding IsFormulaEditorOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{x:Null}"
                                            ContentTemplateSelector="{StaticResource EditorSelector}"
                                            Width="{Binding EditorWidth, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}}"
                                            HorizontalContentAlignment="Right"
                                            VerticalAlignment="Center"/>
                            <!-- 绑定按钮（仅 IsFormulaEnabled）：点击展开/收起覆盖式公式条（不占布局，卡片高度不变） -->
                            <Button Width="20" Height="20" Padding="0" Margin="6,0,0,0"
                                    Command="{Binding ToggleFormulaEditorCommand}"
                                    ToolTip="{loc:Localized SelectBindingSource}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Visibility="{Binding IsFormulaEnabled, Converter={StaticResource BoolToVis}}">
                                <Path Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                                      Fill="{DynamicResource PrimaryBrush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"/>
                            </Button>
                            <!-- 复位按钮（常驻占位：未修改时 Hidden，保留空间，编辑时布局不抖动） -->
                            <Button Width="20" Height="20" Padding="0" Margin="6,0,0,0"
                                    Content="{Binding ResetText}" FontWeight="Bold"
                                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-2}"
                                    ToolTip="{Binding ResetToolTip}"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource IconButtonStyle}">
                                <!-- [EditorChrome(ShowReset=false)] 可整行关掉这个按钮 -->
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource AndVis}">
                                        <Binding Path="IsModified" Converter="{StaticResource BoolToVis}"/>
                                        <Binding Path="ShowResetButton" Converter="{StaticResource BoolToVis}"/>
                                    </MultiBinding>
                                </Button.Visibility>
                            </Button>
                        </StackPanel>

                        <!-- 覆盖式公式条（仅 [FormulaEditor] 标记或 FormulaBound<T> 属性显示）：
                             点绑定按钮后占据值编辑器列（原编辑器此时已隐藏，不需要底板遮挡）；
                             条内右侧自带收起按钮，再点收起。不占布局 → 卡片高度恒定。
                             背景透明：卡片自身有底色，铺一层白会在卡片里镶一块"白毯子"。 -->
                        <!-- 宽度绑定 EditorWidth：值编辑器列是 Auto，普通编辑器靠固定 EditorWidth 撑宽，
                             公式条若不绑同样宽度会缩成"内容自适应"的一小段（输入框只剩几十个像素）。 -->
                        <Border Grid.Column="1"
                                Width="{Binding EditorWidth, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}}"
                                Background="Transparent"
                                Panel.ZIndex="10"
                                Visibility="{Binding IsFormulaEditorOpen, Converter={StaticResource BoolToVis}}">
                            <!-- VerticalAlignment=Center + Height=30：卡片高度由左侧「标题+说明」决定
                                 （说明可能折成多行、卡片比编辑器高得多），条带不居中就会被纵向拉满整张卡片，
                                 公式输入框变成一块又高又空的圆角白块（实测观感很差）。固定 30 = 其他行编辑器
                                 的统一高度，条带居中后输入框与普通编辑器等高；覆盖层背景仍铺满整格，
                                 上下露出的底色=卡片底色，原值编辑器依旧被盖住。 -->
                            <Grid VerticalAlignment="Center" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:FormulaBindingControl Grid.Column="0"
                                                             FormulaString="{Binding FormulaString, Mode=TwoWay}"
                                                             IsReadOnly="{Binding IsReadOnly}"/>
                                <!-- 类型提示(如 "(int)"):淡蓝色斜体,与公式输入框内容颜色区分 -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TypeHint, Converter={StaticResource MiddleEllipsis}, ConverterParameter=7}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-2}"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource PrimaryBrush}" Opacity="0.85"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="72" TextWrapping="NoWrap" ToolTip="{Binding TypeHint}">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource AndVis}">
                                            <Binding Path="TypeHint" Converter="{StaticResource NullToVis}"/>
                                            <Binding Path="ShowTypeHint" RelativeSource="{RelativeSource AncestorType=pg:PropertyGridPro}"
                                                     Converter="{StaticResource BoolToVis}"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <!-- 收起切换按钮（绑定条内自带，再点收起） -->
                                <Button Grid.Column="2" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Command="{Binding ToggleFormulaEditorCommand}"
                                        ToolTip="{loc:Localized CollapseBindingEditor}"
                                        Style="{StaticResource IconButtonStyle}"
                                        VerticalAlignment="Center">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                          Fill="{DynamicResource PrimaryBrush}"
                                          Width="12" Height="12"
                                          Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <!-- 悬停只用描边强调色，避免与卡片底色打架 -->
            <Trigger SourceName="ProRowRoot" Property="IsMouseOver" Value="True">
                <Setter TargetName="ProRowRoot" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Description}" Value="">
                <Setter TargetName="ProRowDescription" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <!-- 关键属性（[Highlight]）：整张卡片常驻强调色描边，一眼能挑出来。
                 刻意放在悬停触发器之后 —— 触发器按声明顺序生效，后者覆盖前者，
                 这样鼠标移上去也不会把强调色"盖回"灰色。 -->
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="ProRowRoot" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                <Setter TargetName="ProRowRoot" Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ========== PropertyGridPro：扁平列表中的「类别头」模板 ==========
         压平为单层列表后，类别头与属性行同级排列，类别头不再包裹属性行。
         视觉沿用原 ProCategoryTemplate 的头部（竖条 + 分类名），分类名为空（默认分类）时不渲染。
         用 x:Key 而非隐式 DataTemplate：隐式模板会污染后代资源查找，导致子属性列表
         解析不到行模板时回退到模板自身 → 无限递归 → 栈溢出（见 ProFlatRowTemplateSelector 注释）。 -->
    <!-- ========== PropertyGridPro：表单式（ProLayout.Section，对齐 VS 2026 选项页）==========
         真实排法（照 VS「应用程序」选项页）：
           ① 分类名占**左侧固定一列**（不是横跨整行的大标题），与第一条属性在同一水平带上；
           ② 右侧每条属性左边有一条**竖线**（强调色），把同一个分类下的属性框成一组，
              竖线在行与行之间连续（间距放在竖线内部，行与行之间不留缝）；
           ③ 属性行 = 名称(+ⓘ) → 说明 → 编辑器，编辑器约占内容区 60%、左对齐；
           ④ 布尔属性换成「复选框 + 名称 + 说明」的勾选项。
         左右两列宽度固定 160：分类头行与属性行用同一个列宽，才能对齐成 VS 那种表格骨架。 -->

    <!-- 分类头行：左列分类名，右列留空（竖线由下面的属性行自己画，从第一条属性开始） -->
    <DataTemplate x:Key="ProSectionCategoryHeaderTemplate">
        <!-- 上边距 34 → 12：分组之间的缝隙和普通版（分类头 10）对齐，
             不至于一个图片行结束后往下留出一大段空白（demo 对比反馈） -->
        <Grid x:Name="ProSectionHeader" Margin="16,12,16,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 分类名做成"淡一号"的分组标签：不压过属性名（SemiBold 主色），但比说明亮 -->
            <TextBlock Grid.Column="0"
                       Text="{Binding Name}"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"
                       Foreground="{DynamicResource PrimaryBrush}"
                       Opacity="0.9"
                       VerticalAlignment="Bottom"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Name}"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="">
                <Setter TargetName="ProSectionHeader" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 属性行：左侧空出分类列，右侧「独立竖线 + 名称/ⓘ/说明/编辑器」
         竖线是**每项各自一段**（圆角胶囊、随内容高度），项与项之间留 24 空白 → 线自然断开，
         与 VS 2026 选项页一致；不是一条通栏竖线。 -->
    <DataTemplate x:Key="ProSectionRowTemplate">
        <Grid>
            <!-- 分组首行顶部留 14 的呼吸（分类名与上方页头/上一组之间不再贴死），
                 其余行留行间距 12（原 24→16→12：图片行底部堆积空白过多，与普通版观感差距大）。
                 Margin 放 Style 里而不是直接写属性 —— 本地值会盖过 DataTrigger。 -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="16,0,16,12"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGroupFirst}" Value="True">
                            <Setter Property="Margin" Value="16,12,16,12"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <!-- Auto + 占位块：有分类头时列宽 176，隐藏分类头时占位块 Collapsed → 列宽归 0，
                     属性自动铺满整行（同一套模板兼顾两种形态） -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 分类之间的横向分隔线：主题边框色（深/浅主题都可见），
                 画在分组首行上方、且只有非首组才出现 -->
            <!-- 分类分隔线（组首行显示）：画在分类名下方、该组第一行上方，全局只此一处。
                 Margin 顶部 -4：从"分类头行内 15px 处"挪到首行卡片正上方，
                 视觉上就是分类名下面那条线（此前画在分类名上方，第一个分类下面缺一条）。 -->
            <Border Grid.Column="0" Grid.ColumnSpan="2"
                    Height="1" VerticalAlignment="Top" Margin="0,-4,0,0"
                    Background="{DynamicResource PrimaryBrush}" Opacity="0.35"
                    Visibility="{Binding ShowGroupSeparator, Converter={StaticResource BoolToVis}}"/>

            <!-- 左侧分类列：分类名只在"分组首行"出现，与第一条属性同一行；
                 列宽 = min(CategoryColumnWidth, 面板宽×0.32) —— 面板拖窄时自动收，不然它会把内容区挤成一条缝。
                 非首行留空以保持内容左缘对齐 -->
            <Grid Grid.Column="0"
                  Visibility="{Binding ShowCategoryHeaders, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource BoolToVis}}">
                <Grid.Width>
                    <MultiBinding Converter="{StaticResource MinRatioLength}" ConverterParameter="0.32">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=pg:PropertyGridPro}"/>
                        <Binding Path="CategoryColumnWidth" RelativeSource="{RelativeSource AncestorType=pg:PropertyGridPro}"/>
                    </MultiBinding>
                </Grid.Width>
                <TextBlock Text="{Binding Category}"
                           Visibility="{Binding IsGroupFirst, Converter={StaticResource BoolToVis}}"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Opacity="0.9"
                           VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Category}"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 关键属性标记：只有 [Highlight] 的属性有一段强调色竖线；
                     未标记时占位仍在（宽 19），保证各行内容左边缘对齐 -->
                <Grid Grid.Column="0" Width="19">
                    <Border Width="3" CornerRadius="1.5"
                            Margin="0,3,0,3"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource PrimaryBrush}"
                            Opacity="0.9"
                            ToolTip="{Binding HighlightTip}"
                            Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <StackPanel Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayName}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="20" Height="20" Padding="0"
                                    Command="{Binding ToggleFormulaEditorCommand}"
                                    ToolTip="{loc:Localized SelectBindingSource}"
                                    Style="{StaticResource IconButtonStyle}">
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource AndVis}">
                                        <Binding Path="IsFormulaEnabled" Converter="{StaticResource BoolToVis}"/>
                                        <Binding Path="IsFormulaEditorOpen" Converter="{StaticResource BoolToVis}" ConverterParameter="Invert"/>
                                    </MultiBinding>
                                </Button.Visibility>
                                <Path Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                                      Fill="{DynamicResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                    Content="{Binding ResetText}" FontWeight="Bold"
                                    ToolTip="{Binding ResetToolTip}"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource IconButtonStyle}">
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource AndVis}">
                                        <Binding Path="IsModified" Converter="{StaticResource BoolToVis}"/>
                                        <Binding Path="ShowResetButton" Converter="{StaticResource BoolToVis}"/>
                                        <Binding Path="IsFormulaEditorOpen" Converter="{StaticResource BoolToVis}" ConverterParameter="Invert"/>
                                    </MultiBinding>
                                </Button.Visibility>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="SectionRowDescription"
                               Text="{Binding Description}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               LineHeight="18"
                               LineStackingStrategy="BlockLineHeight"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-2}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <!-- 编辑器：约占内容区 58%，随面板伸缩（VS 里编辑器比说明略窄） -->
                    <!-- 编辑器与公式条同占一格：进入绑定后编辑器隐藏、公式条接管，
                         公式条背景透明（不再铺底板），与整行同底色。 -->
                    <Grid HorizontalAlignment="Left"
                          Margin="0,9,0,0"
                          MinHeight="30"
                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource RatioLength}, ConverterParameter=0.58}">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{x:Null}"
                                        ContentTemplateSelector="{StaticResource EditorSelector}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsFormulaEditorOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <!-- 背景透明：表单式这里是纯面板底，铺白会变成一条独立白带 -->
                        <Grid Height="30" VerticalAlignment="Center"
                              Background="Transparent"
                              Visibility="{Binding IsFormulaEditorOpen, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:FormulaBindingControl Grid.Column="0"
                                                         Compact="True"
                                                         FormulaString="{Binding FormulaString, Mode=TwoWay}"
                                                         IsReadOnly="{Binding IsReadOnly}"/>
                            <!-- 收起（与基类网格的公式条一致：条内自带 X，再点收起） -->
                            <Button Grid.Column="2" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                    Command="{Binding ToggleFormulaEditorCommand}"
                                    ToolTip="{loc:Localized CollapseBindingEditor}"
                                    Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="{DynamicResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TypeHint, Converter={StaticResource MiddleEllipsis}, ConverterParameter=7}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       FontStyle="Italic"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="72" TextWrapping="NoWrap"
                                       ToolTip="{Binding TypeHint}"
                                       Foreground="{DynamicResource PrimaryBrush}" Opacity="0.85"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-2}">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource AndVis}">
                                        <Binding Path="TypeHint" Converter="{StaticResource NullToVis}"/>
                                        <Binding Path="ShowTypeHint" RelativeSource="{RelativeSource AncestorType=pg:PropertyGridPro}" Converter="{StaticResource BoolToVis}"/>
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                <Setter TargetName="SectionRowDescription" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Description}" Value="">
                <Setter TargetName="SectionRowDescription" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 表单式的布尔勾选项：复选框本身就是编辑器，标题与说明在下方（对齐 VS 选项页的「引用程序集 / 文档文件」项） -->
    <DataTemplate x:Key="ProSectionCheckRowTemplate">
        <Grid>
            <!-- 分组首行顶部留 14 的呼吸（分类名与上方页头/上一组之间不再贴死），
                 其余行留行间距 12（原 24→16→12：图片行底部堆积空白过多，与普通版观感差距大）。
                 Margin 放 Style 里而不是直接写属性 —— 本地值会盖过 DataTrigger。 -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="16,0,16,12"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGroupFirst}" Value="True">
                            <Setter Property="Margin" Value="16,12,16,12"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 分类分隔线（组首行显示）：画在分类名下方、该组第一行上方，全局只此一处。
                 Margin 顶部 -4：从"分类头行内 15px 处"挪到首行卡片正上方，
                 视觉上就是分类名下面那条线（此前画在分类名上方，第一个分类下面缺一条）。 -->
            <Border Grid.Column="0" Grid.ColumnSpan="2"
                    Height="1" VerticalAlignment="Top" Margin="0,-4,0,0"
                    Background="{DynamicResource PrimaryBrush}" Opacity="0.35"
                    Visibility="{Binding ShowGroupSeparator, Converter={StaticResource BoolToVis}}"/>

            <!-- 左侧分类列（与普通属性行同一套列宽与首行规则） -->
            <Grid Grid.Column="0"
                  Visibility="{Binding ShowCategoryHeaders, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource BoolToVis}}">
                <Grid.Width>
                    <MultiBinding Converter="{StaticResource MinRatioLength}" ConverterParameter="0.32">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=pg:PropertyGridPro}"/>
                        <Binding Path="CategoryColumnWidth" RelativeSource="{RelativeSource AncestorType=pg:PropertyGridPro}"/>
                    </MultiBinding>
                </Grid.Width>
                <TextBlock Text="{Binding Category}"
                           Visibility="{Binding IsGroupFirst, Converter={StaticResource BoolToVis}}"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Opacity="0.9"
                           VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Category}"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="19">
                    <Border Width="3" CornerRadius="1.5"
                            Margin="0,3,0,3"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource PrimaryBrush}"
                            Opacity="0.9"
                            ToolTip="{Binding HighlightTip}"
                            Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                              IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                              VerticalContentAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"/>
                    </CheckBox>
                    <TextBlock x:Name="SectionCheckDescription"
                               Text="{Binding Description}"
                               TextWrapping="Wrap"
                               Margin="24,5,0,0"
                               LineHeight="18"
                               LineStackingStrategy="BlockLineHeight"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-2}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                <Setter TargetName="SectionCheckDescription" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Description}" Value="">
                <Setter TargetName="SectionCheckDescription" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ProFlatCategoryHeaderTemplate">
        <!-- 分类头只负责标题，不画分隔线 —— 分隔线统一由行模板画在分类头下方（只此一处），
             否则分类头上下会各出一条（demo 反馈"多出来一个分类线"）。 -->
        <StackPanel x:Name="ProFlatCategoryHeader"
                    Orientation="Horizontal"
                    Margin="16,14,16,6">
            <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,8,0"
                    Background="{DynamicResource PrimaryBrush}"
                    VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Name}"
                       FontWeight="Bold"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"
                       Foreground="{DynamicResource PrimaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <!-- 无分类名（默认分类）时不渲染分组头 -->
            <DataTrigger Binding="{Binding Name}" Value="">
                <Setter TargetName="ProFlatCategoryHeader" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ========== PropertyGridPro：分类模板（无 Expander，不折叠） ========== -->
    <DataTemplate x:Key="ProCategoryTemplate">
        <StackPanel>
            <StackPanel x:Name="ProCategoryHeader"
                        Orientation="Horizontal"
                        Margin="16,14,16,6">
                <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,8,0"
                        Background="{DynamicResource PrimaryBrush}"
                        VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}"
                           FontWeight="Bold"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, Converter={StaticResource FontSizeOffset}, ConverterParameter=1}"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource ProPropertyRowTemplate}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <!-- 无分类名（默认分类 / 关闭分类标题）时不渲染分组头 -->
            <DataTrigger Binding="{Binding Name}" Value="">
                <Setter TargetName="ProCategoryHeader" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ========== PropertyGridPro 默认样式 ========== -->
    <Style TargetType="{x:Type pg:PropertyGridPro}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="EditorWidth" Value="280"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- 行模板注入：顶层行与展开后的各级子属性行复用同一张卡片模板 -->
        <Setter Property="RowTemplate" Value="{StaticResource ProPropertyRowTemplate}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type pg:PropertyGridPro}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid TextElement.FontFamily="{Binding FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                              TextElement.FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <!-- 底部常驻描述区 + 可上下拖动的分隔条（与基础网格一致）；
                                     ShowDescription=false 时 cs 把两行行高压 0（固定行不随内容收缩，会留空白） -->
                                <RowDefinition x:Name="PART_ProSplitterRow" Height="4"/>
                                <RowDefinition x:Name="PART_ProDescriptionRow" Height="80" MinHeight="40" MaxHeight="300"/>
                            </Grid.RowDefinitions>

                            <!-- 头部：标题 + 说明 + 来源 + 搜索框 -->
                            <StackPanel Grid.Row="0">
                                <StackPanel x:Name="PART_HeaderPanel"
                                            Margin="16,14,16,18"
                                            Visibility="{Binding ShowHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock x:Name="PART_HeaderText"
                                               FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FontSizeOffset}, ConverterParameter=7}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PART_HeaderDescriptionText"
                                               Text="{Binding HeaderDescription, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-1}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                    <TextBlock x:Name="PART_SourceText"
                                               Text="{Binding SourceText, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-3}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Opacity="0.75"/>
                                </StackPanel>

                                <!-- 属性搜索 -->
                                <Grid Margin="16,12,16,8"
                                      Visibility="{Binding ShowSearchBar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <hc:SearchBar x:Name="PART_SearchBox"
                                                  Grid.Column="0"
                                                  Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                  hc:InfoElement.Placeholder="{loc:Localized SearchPlaceholder}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MatchCountText, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,2,0"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                            </StackPanel>

                            <!-- 属性平铺列表（与基类 PropertyGrid 同款「压平 + 虚拟化」）：
                                 行卡片已统一为「单行说明 + 固定高编辑器区」，行高一致，
                                 VirtualizingStackPanel + Recycling 只生成视口内的卡片
                                 （此前 StackPanel 全量生成 77+ 张卡片，实测每次重建 672ms，
                                 展开/筛选重建瞬间卡顿）。滚动估算由代码侧"首行预热"修正
                                 （见 PropertyGridPro.ApplyFilter，与基类同款）。
                                 顶部 8px 留白：无标题区时首行不贴控件顶边。 -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <ItemsControl x:Name="PART_ItemsControl"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer x:Name="PART_ScrollViewer"
                                                          CanContentScroll="True"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          behaviors:TouchScroll.IsEnabled="True"
                                                          Padding="0,2,0,8">
                                                <ScrollViewer.Resources>
                                                    <!-- 稳定滚动条：拇指常显、hover 只变色（见 StableScrollBar） -->
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource StableScrollBar}"/>
                                                </ScrollViewer.Resources>
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <!-- 行模板分派：类别头用固定模板、属性行用宿主 RowTemplate。
                                         刻意不用隐式 DataTemplate（DataType=PropertyItem）：
                                         隐式模板对后代元素同样生效，属性行模板内的子属性列表一旦
                                         解析不到 RowTemplate 就会回退到该隐式模板自身 → 无限递归
                                         → 栈溢出（进程直接起不来）。详见 ProFlatRowTemplateSelector。 -->
                                    <ItemsControl.ItemTemplateSelector>
                                        <!-- 两套模板都挂上，由 PropertyGridPro.Layout 在代码里切换（模板键在主题字典里，
                                             代码侧 TryFindResource 取不到，故在模板作用域内一次解析好） -->
                                        <pg:ProFlatRowTemplateSelector
                                            x:Name="PART_RowTemplateSelector"
                                            CategoryTemplate="{StaticResource ProFlatCategoryHeaderTemplate}"
                                            SectionCategoryTemplate="{StaticResource ProSectionCategoryHeaderTemplate}"
                                            SectionRowTemplate="{StaticResource ProSectionRowTemplate}"
                                            CheckRowTemplate="{StaticResource ProSectionCheckRowTemplate}"/>
                                    </ItemsControl.ItemTemplateSelector>
                                </ItemsControl>

                                <!-- 空状态 -->
                                <TextBlock Text="{loc:Localized ProNoResult}"
                                           Visibility="{Binding HasNoResult, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="16"/>
                            </Grid>

                            <!-- 可上下拖动的分隔条：调整属性列表与底部描述区的高度比例（随 ShowDescription 隐藏） -->
                            <GridSplitter Grid.Row="2"
                                          Visibility="{Binding ShowDescription, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"
                                          Height="4"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource BorderBrush}"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Rows"
                                          Cursor="SizeNS"/>

                            <!-- 底部常驻描述区：显示当前选中属性的名称 + 说明（随 ShowDescription 隐藏） -->
                            <Border Grid.Row="3"
                                    Visibility="{Binding ShowDescription, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource SecondaryRegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedPropertyItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedPropertyItem.Description, RelativeSource={RelativeSource TemplatedParent}}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="PART_HeaderText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HeaderDescription, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="PART_HeaderDescriptionText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SourceText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="PART_SourceText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

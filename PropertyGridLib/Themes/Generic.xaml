<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:PropertyGridLib.Controls"
    xmlns:pg="clr-namespace:PropertyGridLib"
    xmlns:conv="clr-namespace:PropertyGridLib.Converters"
    xmlns:behaviors="clr-namespace:PropertyGridLib.Behaviors"
    xmlns:loc="clr-namespace:PropertyGridLib.Localization">

    <!-- 转换器 -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:BoolToHiddenVisibilityConverter x:Key="BoolToHiddenVis"/>
    <conv:InverseBoolConverter x:Key="InverseBool"/>
    <conv:FirstLineConverter x:Key="FirstLine"/>
    <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    <conv:IsNoneToVisibilityConverter x:Key="IsNoneVis"/>
    <conv:AndVisConverter x:Key="AndVis"/>
    <!-- 复位按钮 R：未修改时 Hidden（保留槽位，编辑器列宽不随 R 出现/消失而抖） -->
    <conv:ResetButtonVisConverter x:Key="ResetButtonVis"/>
    <conv:IntToDoubleConverter x:Key="IntToDouble"/>
    <conv:DateTimeConverter x:Key="DateTimeConv"/>
    <conv:ObjectToTypeConverter x:Key="ObjToType"/>
    <conv:FontSizeOffsetConverter x:Key="FontSizeOffset"/>
    <!-- 绑定源键名/类型提示过长时的「前缀…后缀」中间省略 -->
    <conv:MiddleEllipsisConverter x:Key="MiddleEllipsis"/>
    <!-- 长度的指定比例：Small 布局标题列「Auto 但最多 50%」的封顶用 -->
    <conv:RatioLengthConverter x:Key="RatioLength"/>
    <!-- 表单式分类列宽：min(期望列宽, 面板宽 × 比例)，面板拖窄时不让分类列挤死内容区 -->
    <conv:MinRatioLengthConverter x:Key="MinRatioLength"/>
    <!-- Color → 冻结画刷 转换器。颜色编辑器的色块预览已改绑 ColorEditControl 自己的 SwatchBrush
         （见下面的 ColorEditControl 模板），该资源键保留给宿主在自定义行模板里继续使用。 -->
    <conv:ColorToBrushConverter x:Key="ColorToBrush"/>

    <!-- Popup 阴影效果 -->
    <DropShadowEffect x:Key="PopupShadowEffect"
                      BlurRadius="10"
                      ShadowDepth="2"
                      Opacity="0.3"
                      Color="Black"/>
    

    <!-- ═══════════ 稳定滚动条（属性列表专用）═══════════
         HandyControl 默认滚动条是"平时细线、hover 变粗块"的两态样式 ——
         滚动时观感像拇指忽大忽小、判断不了内容有多长（demo 反复反馈）。
         这里换一套稳定样式：拇指常显（半透明灰 6px 圆角条），hover 只变主题色，
         粗细与尺寸不变。只覆盖纵向（属性列表不出现横向滚动条，横向保留默认样式）。 -->
    <Style x:Key="StableScrollBar" TargetType="ScrollBar">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBar"
                                                            Width="6" CornerRadius="3" Margin="0,3"
                                                            Background="{DynamicResource SecondaryTextBrush}"
                                                            Opacity="0.35"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBar" Property="Background"
                                                                    Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter TargetName="ThumbBar" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBar" Property="Background"
                                                                    Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter TargetName="ThumbBar" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                                      Opacity="0" Background="Transparent"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                                      Opacity="0" Background="Transparent"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== 圆角图标按钮样式（透明背景 + 悬停圆角高亮 + 主题前景色） ========== -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource RegionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource RegionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpandToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButtonStyle}">
        <!-- 嵌套结构的展开箭头：字体 ▶（收起）/ ▼（展开）。固定 26×26 + 字号 14：
             尺寸统一（不再随字符渲染盒忽大忽小），且保持小巧。 -->
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Content" Value="&#x25B6;"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="&#x25BC;"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- FormulaTreeNode 层级模板 -->
    <HierarchicalDataTemplate DataType="{x:Type local:FormulaTreeNode}"
                              ItemsSource="{Binding Children}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 键名过长时中间省略成「前3字…后3字」：前缀是流程/任务层级、后缀是属性名末尾，
                 比纯尾部省略更容易认；完整文本走 ToolTip，不用横向拉。
                 树里横向滚动已禁用，省略后的文本会在类型胶囊左侧自然收窄。 -->
            <TextBlock Grid.Column="0"
                       Text="{Binding Header, Converter={StaticResource MiddleEllipsis}, ConverterParameter=7}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Header}"/>
            <!-- 类型提示(如 “(int)”)：宿主未填 FormulaType 时 TypeHint 为 null，不显示。
                 绑定源树里不受 ShowTypeHint 开关控制 —— 选绑定源时类型一眼有用，
                 行内公式条上的提示才受那个开关管（那里挤）。 -->
            <!-- 类型提示做成淡色小胶囊（斜体强调色）：与键名拉开层次，
                 泛型类型名（Dictionary<String, List<Double>>）太长时中间省略，全文走 ToolTip -->
            <Border Grid.Column="1"
                    Margin="8,0,2,0"
                    Padding="5,1"
                    CornerRadius="3"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    MaxWidth="140"
                    Visibility="{Binding TypeHint, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding TypeHint, Converter={StaticResource MiddleEllipsis}, ConverterParameter=16}"
                           FontSize="11"
                           FontStyle="Italic"
                           Opacity="0.9"
                           Foreground="{DynamicResource PrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TypeHint}"/>
            </Border>
        </Grid>
    </HierarchicalDataTemplate>

    <!-- 公式树的行样式（Popup 里那棵"选择绑定源"的树）。
         默认 TreeViewItem 模板只把 Header 那一小块涂成选中色 —— 面板左上角因此会出现一块
         与行不对齐的灰方块（像瑕疵）。这里整行铺满：选中/悬停都是整行淡底，
         展开箭头也换成主题色小三角，不再吃 HandyControl 的 ToggleButton 样式。 -->
    <Style x:Key="FormulaTreeItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <!-- 去掉键盘焦点框：WPF 默认焦点视觉是"四角小黑方块"，在弹出面板里非常显眼 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Border x:Name="RowBg"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="2,4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 选中态：淡主题色底 + 左侧强调竖条（不抢键名，但一眼能看出选中） -->
                                <Border x:Name="SelTint"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Opacity="0"
                                        CornerRadius="4"/>
                                <Border x:Name="SelBar"
                                        Width="3"
                                        Margin="0,2,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="1.5"
                                        Visibility="Collapsed"/>
                                <Grid Margin="6,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 展开箭头：可点击的 ToggleButton，双向绑定 IsExpanded，
                                         单击箭头即展开/收起（纯图形无法响应点击）。 -->
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Width="16" Height="16"
                                                  Margin="0,0,4,0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="4">
                                                    <Path x:Name="Arrow"
                                                          Width="7" Height="7"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"
                                                          Stretch="Uniform"
                                                          Data="M0,0 L4,4 L0,8 Z"
                                                          Fill="{DynamicResource SecondaryTextBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,2"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- 没有子项时不显示箭头（箭头旋转由 ToggleButton 自己的模板处理） -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelTint" Property="Opacity" Value="0.12"/>
                            <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 编辑器模板选择器 -->
    <local:EditorTemplateSelector x:Key="EditorSelector">
        <local:EditorTemplateSelector.StringTemplate>
            <DataTemplate>
                <TextBox Text="{Binding ValueString, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                         IsReadOnly="{Binding IsReadOnly}"
                         VerticalContentAlignment="Center"/>
            </DataTemplate>
        </local:EditorTemplateSelector.StringTemplate>

        <!-- 链接（新的值形态）：字符串值本身是 http/https/ftp/mailto 时自动命中。
             外观照超链接：主色 + 下划线 + 手型光标，点击交给 OpenLinkCommand 用系统默认程序打开。 -->
        <local:EditorTemplateSelector.LinkTemplate>
            <DataTemplate>
                <Button Command="{Binding OpenLinkCommand}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="{Binding ValueString}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{Binding ValueString}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DataTemplate>
        </local:EditorTemplateSelector.LinkTemplate>

        <!-- 图像预览（新的值形态）：值是图像时自动命中 ——
             内置识别 ImageSource / 图像文件字节流，以及宿主经 ImagePreviewRegistry 登记的自定义
             图像类型（平台契约的 GenImage 就属于这种）。缩略图点开看大图。 -->
        <local:EditorTemplateSelector.ImageTemplate>
            <DataTemplate>
                <!-- 紧凑横向：小缩略图 + 右侧尺寸说明。
                     刻意不撑高行：基础网格的行高是固定值（虚拟化估算依赖它），
                     竖向堆叠的缩略图会把行撑高、把下面几行挤出视口。要大图点开预览窗。 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Height/MinHeight 需显式覆盖：按钮隐式样式带固定高度，会把缩略图压扁。
                         这里尺寸完全由图片决定。 -->
                    <Button Command="{Binding PreviewImageCommand}"
                            Cursor="Hand"
                            Focusable="False"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Height="Auto"
                            MinHeight="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ToolTip="{Binding ImageInfo}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ImageFrame"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="2"
                                        Background="{DynamicResource SecondaryRegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid>
                                        <!-- 缩略图尺寸随宿主：Pro 的行高由内容决定，给 88×66；
                                             基础 PropertyGrid 行高固定 34/56，绑定找不到 Pro 祖先时
                                             走 FallbackValue 的 44×33（正好塞进一行）。 -->
                                        <Image Source="{Binding ImagePreview}"
                                               Width="{Binding ImageThumbnailWidth, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, FallbackValue=44}"
                                               Height="{Binding ImageThumbnailHeight, RelativeSource={RelativeSource AncestorType=pg:PropertyGridPro}, FallbackValue=28}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="ImageEmpty"
                                                   Text="{loc:Localized NoPreview}"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   Visibility="Collapsed"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ImageFrame" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <!-- 拿不到位图（像素格式不支持 / 转换函数报错）时显示"无预览"占位。
                                         必须放在 ControlTemplate 里：ImageEmpty 是模板内元素，
                                         DataTemplate 的触发器够不到它。 -->
                                    <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                        <Setter TargetName="ImageEmpty" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 尺寸 / 像素格式：一行小字，无信息时不占位 -->
                    <TextBlock x:Name="ImageInfoText"
                               Text="{Binding ImageInfo}"
                               Margin="8,0,0,0"
                               MaxWidth="150"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-3}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ImageInfo}" Value="{x:Null}">
                        <Setter TargetName="ImageInfoText" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ImageInfo}" Value="">
                        <Setter TargetName="ImageInfoText" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </local:EditorTemplateSelector.ImageTemplate>

        <local:EditorTemplateSelector.BooleanTemplate>
            <DataTemplate>
                <ToggleButton IsChecked="{Binding Value, Converter={StaticResource ObjToType}, FallbackValue=false}"
                              IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                              Style="{DynamicResource ToggleButtonSwitch}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"/>
            </DataTemplate>
        </local:EditorTemplateSelector.BooleanTemplate>

        <!-- [ToggleSwitch] 特性：bool 专用开关编辑器 —— 滑块式开关（圆角轨道 + 圆形滑块）+ 可选的 开/关 状态文字。
             水平对齐跟随宿主编辑器 ContentControl 的 HorizontalContentAlignment：
             基类 PropertyGrid 默认 Left（编辑器占满整行，开关靠左，与历史行为一致）；
             Pro 卡片编辑器右对齐（HorizontalContentAlignment=Right），开关+状态文字随之靠右。 -->
        <local:EditorTemplateSelector.ToggleSwitchTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ContentControl}, FallbackValue=Left}"
                            VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding Value, Mode=TwoWay, Converter={StaticResource ObjToType}, FallbackValue=false}"
                                  IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                  Style="{DynamicResource ToggleButtonSwitch}"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToggleStateText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Visibility="{Binding ToggleStateTextVisibility}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </local:EditorTemplateSelector.ToggleSwitchTemplate>

        <!-- [MultilineText] 特性：string 专用多行文本编辑器 —— 行内单行只读预览 + … 按钮，
             点击弹出多行富文本编辑窗口（Wrap + 回车 + 滚动）。行内等高，不破坏虚拟化估算。 -->
        <local:EditorTemplateSelector.MultilineTextTemplate>
            <DataTemplate>
                <local:MultilineTextControl DataContext="{Binding}"/>
            </DataTemplate>
        </local:EditorTemplateSelector.MultilineTextTemplate>

        <local:EditorTemplateSelector.NumberTemplate>
            <DataTemplate>
                <hc:NumericUpDown Value="{Binding ValueString, Converter={StaticResource ObjToType}, UpdateSourceTrigger=LostFocus, FallbackValue=0}"
                                  IsReadOnly="{Binding IsReadOnly}"
                                  VerticalContentAlignment="Center"/>
            </DataTemplate>
        </local:EditorTemplateSelector.NumberTemplate>

        <local:EditorTemplateSelector.EnumTemplate>
            <DataTemplate>
                <!-- 枚举显示项：[Description] 原文经翻译（默认中文），无特性回退成员名 -->
                <ComboBox ItemsSource="{Binding EnumDisplayItems}"
                          SelectedItem="{Binding EnumSelectedItem, Mode=TwoWay, FallbackValue=null}"
                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                          VerticalContentAlignment="Center"/>
            </DataTemplate>
        </local:EditorTemplateSelector.EnumTemplate>

        <local:EditorTemplateSelector.DateTimeTemplate>
            <DataTemplate>
                <hc:DateTimePicker SelectedDateTime="{Binding Value, Converter={StaticResource DateTimeConv}, FallbackValue=null}"
                                   IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                   VerticalContentAlignment="Center"/>
            </DataTemplate>
        </local:EditorTemplateSelector.DateTimeTemplate>

        <local:EditorTemplateSelector.FilePathTemplate>
            <DataTemplate>
                <!-- 路径选择控件（可独立使用的 SDK 控件）：文本框 + 浏览按钮 -->
                <local:FilePathControl
                    Text="{Binding ValueString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                    Filter="{Binding FileFilter}"
                    IsReadOnly="{Binding IsReadOnly}"/>
            </DataTemplate>
        </local:EditorTemplateSelector.FilePathTemplate>

        <local:EditorTemplateSelector.DirectoryPathTemplate>
            <DataTemplate>
                <!-- 目录选择控件（SelectDirectory=true 走目录浏览器） -->
                <local:FilePathControl
                    Text="{Binding ValueString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                    SelectDirectory="True"
                    IsReadOnly="{Binding IsReadOnly}"/>
            </DataTemplate>
        </local:EditorTemplateSelector.DirectoryPathTemplate>

        <local:EditorTemplateSelector.CollectionTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 值框外观：与路径/文本编辑器一致（白底 + 圆角描边），显示项数摘要；
                         点右侧「...」才打开集合编辑器（不再把编辑区内联展开）。 -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,0" MinHeight="30"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding ValueString}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="1"
                            Content="..."
                            MinWidth="30"
                            Width="auto"
                            Margin="4,0,0,0"
                            Command="{Binding EditCollectionCommand}"
                            ToolTip="{loc:Localized OpenCollectionEditor}"/>
                </Grid>
            </DataTemplate>
        </local:EditorTemplateSelector.CollectionTemplate>

        <!-- 字典（IDictionary）：显示条目数 + “...”按钮，点击打开 DictionaryEditorDialog -->
        <local:EditorTemplateSelector.DictionaryTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 值框外观与集合/路径编辑器一致；点「...」打开字典编辑器 -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,0" MinHeight="30"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding ValueString}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="1"
                            Content="..."
                            MinWidth="30"
                            Width="auto"
                            Margin="4,0,0,0"
                            Command="{Binding EditCollectionCommand}"
                            ToolTip="{loc:Localized OpenDictionaryEditor}"/>
                </Grid>
            </DataTemplate>
        </local:EditorTemplateSelector.DictionaryTemplate>

        <local:EditorTemplateSelector.SliderTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Value="{Binding Value, Converter={StaticResource IntToDouble}, FallbackValue=0, TargetNullValue=0}"
                            Minimum="{Binding SliderMinimum}"
                            Maximum="{Binding SliderMaximum}"
                            TickFrequency="{Binding SliderStep}"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"/>
                    <!-- 数字输入框（ShowNumberBox=true 时显示），与滑块双向同步：
                         Minimum/Maximum/Increment 跟随 NumberSlider 特性，
                         键入与 +/- 步进都会被边界钳制；失焦提交避免中间输入反复解析 -->
                    <hc:NumericUpDown Grid.Column="1"
                                      Value="{Binding ValueString, Converter={StaticResource ObjToType}, UpdateSourceTrigger=LostFocus, FallbackValue=0}"
                                      Minimum="{Binding SliderMinimum}"
                                      Maximum="{Binding SliderMaximum}"
                                      Increment="{Binding SliderStep}"
                                      Width="Auto"
                                      MinWidth="72"
                                      MaxWidth="140"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      Visibility="{Binding SliderShowNumberBox, Converter={StaticResource BoolToVis}}"
                                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"/>
                    <!-- 只读数值标签（默认显示；开启 ShowNumberBox 后由数字框取代） -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding ValueString}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Visibility="{Binding SliderShowNumberBox, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                </Grid>
            </DataTemplate>
        </local:EditorTemplateSelector.SliderTemplate>

        <!-- 范围滑块（属性类型为 RangeValue 时自动启用；[RangeSlider] 配最小值/最大值/步长） -->
        <local:EditorTemplateSelector.RangeSliderTemplate>
            <DataTemplate>
                <!-- 边界属性须写在 Value 之前：控件先拿到边界范围再设区间值，避免被默认 0~100 钳制 -->
                <local:RangeSliderControl
                    Minimum="{Binding SliderMinimum}"
                    Maximum="{Binding SliderMaximum}"
                    Step="{Binding SliderStep}"
                    IsReadOnly="{Binding IsReadOnly}"
                    Value="{Binding Value, Mode=TwoWay}"/>
            </DataTemplate>
        </local:EditorTemplateSelector.RangeSliderTemplate>

        <local:EditorTemplateSelector.DropDownTemplate>
            <DataTemplate>
                <ComboBox ItemsSource="{Binding StandardValues}"
                          SelectedItem="{Binding Value, Mode=TwoWay, FallbackValue=null}"
                          IsEditable="{Binding IsStandardValuesExclusive, Converter={StaticResource InverseBool}}"
                          Text="{Binding ValueString, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                          VerticalContentAlignment="Center"/>
            </DataTemplate>
        </local:EditorTemplateSelector.DropDownTemplate>

        <local:EditorTemplateSelector.MultiSelectTemplate>
            <DataTemplate>
                <local:MultiSelectControl
                    SelectedItems="{Binding Value, Mode=TwoWay}"
                    IsReadOnly="{Binding IsReadOnly}"/>
            </DataTemplate>
        </local:EditorTemplateSelector.MultiSelectTemplate>

        <!-- 命令按钮（[Button] 特性）：不显示值，点击触发 ButtonClickCommand → ButtonClicked 事件 -->
        <local:EditorTemplateSelector.ButtonTemplate>
            <DataTemplate>
                <Button Content="{Binding ButtonText}"
                        Command="{Binding ButtonClickCommand}"
                        HorizontalAlignment="Left"
                        MinWidth="88"
                        Padding="14,4"
                        VerticalContentAlignment="Center"/>
            </DataTemplate>
        </local:EditorTemplateSelector.ButtonTemplate>

        <local:EditorTemplateSelector.ExpandableTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  Width="18" Height="18"
                                  Padding="0" Margin="0,0,4,0"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=pg:PropertyGrid}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-2}"
                                  Style="{StaticResource ExpandToggleButtonStyle}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ValueString}"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"/>
                </Grid>
            </DataTemplate>
        </local:EditorTemplateSelector.ExpandableTemplate>

        <local:EditorTemplateSelector.ColorTemplate>
            <DataTemplate>
                <local:ColorEditControl DataContext="{Binding}"/>
            </DataTemplate>
        </local:EditorTemplateSelector.ColorTemplate>

        <local:EditorTemplateSelector.DefaultTemplate>
            <DataTemplate>
                <!-- 纯文本只读值：必须显式 PrimaryTextBrush —— 不设时继承到的是默认黑，
                     深色主题里值文本直接看不见（属性名同款画刷） -->
                <TextBlock Text="{Binding ValueString}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
            </DataTemplate>
        </local:EditorTemplateSelector.DefaultTemplate>
    </local:EditorTemplateSelector>

    <!-- ========== FormulaBindingControl 样式 ========== -->
    <Style TargetType="{x:Type local:FormulaBindingControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FormulaBindingControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <hc:TextBox x:Name="PART_Input" Grid.Column="0"
                                 Text="{Binding FormulaString, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                 FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-1}"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{Binding FormulaString, RelativeSource={RelativeSource TemplatedParent}}"
                                 hc:InfoElement.Placeholder="{loc:Localized FormulaPlaceholder}"/>
                        <!-- 选绑定源：淡主题色圆角按钮；悬停/弹窗打开时加深，
                             比"透明背景 + 细图标"更像一个可点的入口 -->
                        <ToggleButton Grid.Column="1"
                                      x:Name="PART_PopupButton"
                                      Width="24" Height="24"
                                      Padding="0" Margin="4,0,0,0"
                                      Cursor="Hand"
                                      ToolTip="{loc:Localized SelectBindingSource}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid x:Name="BtnRoot">
                                        <Border x:Name="BtnBg"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Opacity="0.10"
                                                CornerRadius="5"/>
                                        <Border x:Name="BtnEdge"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1"
                                                Opacity="0.35"
                                                CornerRadius="5"/>
                                        <Path x:Name="PART_PopupIcon"
                                              Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                                              Fill="{DynamicResource PrimaryBrush}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBg" Property="Opacity" Value="0.18"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="BtnBg" Property="Opacity" Value="0.22"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="BtnRoot" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- AllowsTransparency 必须开：关闭时系统会给 Popup 套一个"方形不透明窗口"，
                             内容那层 Border 有 CornerRadius，四个角就露出窗口底色 —— 看起来是四个黑角。
                             开了之后 Popup 自己无边框，圆角才是真圆角。 -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsChecked, ElementName=PART_PopupButton}"
                               PlacementTarget="{Binding ElementName=PART_PopupButton}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Width="320" Height="400">
                            <!-- 外层留 8 边给阴影：圆角 + 描边 + 阴影一起，面板才"浮"在行上方 -->
                            <Border Margin="8"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Effect="{StaticResource PopupShadowEffect}"
                                    TextElement.FontFamily="{Binding FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextElement.FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- 面板头：图标徽标 + 标题 -->
                                    <Grid Grid.Row="0" Margin="10,8,10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="22" Height="22" Margin="0,0,8,0">
                                            <Border Background="{DynamicResource PrimaryBrush}"
                                                    Opacity="0.14" CornerRadius="5"/>
                                            <Path Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                                                  Fill="{DynamicResource PrimaryBrush}"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Text="{loc:Localized SelectBindingSource}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                    <Border Grid.Row="1" Height="1" Margin="8,0"
                                            Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                                    <TreeView x:Name="PART_TreeView"
                                              Grid.Row="2"
                                              Margin="6,4,6,6"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              FocusVisualStyle="{x:Null}"
                                              ItemContainerStyle="{StaticResource FormulaTreeItemStyle}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 紧凑模式（PropertyGrid 行内覆盖式公式条）：输入框更小、占位简化、弹树按钮收窄 -->
                        <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="PART_Input"
                                    Property="FontSize"
                                    Value="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FontSizeOffset}, ConverterParameter=-2}"/>
                            <Setter TargetName="PART_Input" Property="hc:InfoElement.Placeholder" Value="{loc:Localized FormulaPlaceholderCompact}"/>
                            <Setter TargetName="PART_PopupButton" Property="Width" Value="20"/>
                            <Setter TargetName="PART_PopupButton" Property="Height" Value="20"/>
                            <Setter TargetName="PART_PopupButton" Property="Margin" Value="2,0,0,0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== MultiSelectControl 样式 ========== -->
    <Style TargetType="{x:Type local:MultiSelectControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MultiSelectControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SummaryText, RelativeSource={RelativeSource TemplatedParent}}"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <ToggleButton Grid.Column="1"
                                      x:Name="PART_PopupButton"
                                      Width="24" Height="24"
                                      Padding="0" Margin="4,0,0,0"
                                      Style="{StaticResource IconToggleButtonStyle}"
                                      ToolTip="{loc:Localized SelectMultiple}"
                                      IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InverseBool}}">
                            <Path Data="M7,10 L12,15 L17,10"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  StrokeThickness="2"
                                  Fill="Transparent"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </ToggleButton>
                        <!-- 同公式树：不开透明，圆角处会露出系统的方形底（四个黑角） -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsChecked, ElementName=PART_PopupButton}"
                               PlacementTarget="{Binding ElementName=PART_PopupButton}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               Width="250" MaxHeight="400">
                            <Border Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4"
                                    TextElement.FontFamily="{Binding FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextElement.FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{loc:Localized SelectItems}" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="4,2,4,4"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  behaviors:TouchScroll.IsEnabled="True">
                                        <ItemsControl x:Name="PART_CheckBoxList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Text}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Margin="4,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== MultilineTextControl 样式（[MultilineText] 特性） ==========
         行内：单行只读预览（与普通 TextBox 同尺寸，保持行高一致）+ … 按钮。
         编辑：点击按钮弹窗多行富文本（控件代码内构建），不改变行内布局。 -->
    <Style TargetType="{x:Type local:MultilineTextControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MultilineTextControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 单行只读预览：首行 + 省略号（FirstLineConverter 剥掉 \n —— TextBlock/TextBox
                             都会把 \n 渲染成真实换行，TextTrimming 只管横向截断，不剥换行预览框会
                             竖向长到 4 行撑破卡片）；完整内容看 ToolTip / 点 … 弹窗编辑 -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ValueString, Mode=OneWay, FallbackValue='', Converter={StaticResource FirstLine}}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding ValueString}"/>
                        <!-- … 按钮（只读=只读浏览弹窗：正文只读、无确定；可编辑=编辑弹窗）。
                              两种模式都保留按钮 —— 只读模式下用户仍需查看完整多行内容 -->
                        <Button Grid.Column="1"
                                x:Name="PART_OpenButton"
                                Content="…"
                                MinWidth="30"
                                Margin="4,0,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== FilePathControl 样式（路径选择控件，可独立使用） ==========
         单行文本框 + 「...」浏览按钮；SelectDirectory=false 选文件 / true 选目录。
         只读时文本框只读、浏览按钮禁用。属性网格的 [FilePath]/[DirectoryPath] 编辑器内部即此控件。 -->
    <Style TargetType="{x:Type local:FilePathControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FilePathControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PART_TextBox" Grid.Column="0"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="PART_BrowseButton" Grid.Column="1"
                                Content="..."
                                MinWidth="30"
                                Margin="4,0,0,0"
                                IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InverseBool}}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== RangeSliderControl 样式（范围滑块控件，可独立使用） ==========
         双滑块选区间，行内不常驻数字；按下拖动时在滑块上方显示「起点 ~ 终点」气泡
         （气泡是模板内 Border，由 RangeSliderControl 在鼠标按下/抬起时切换 Visibility，
         数值随 ValueStart/ValueEnd 刷新；hc 的 RangeSlider 模板不认 TipElement，也不能用 Popup——
         独立 HWND 在属性行里会被裁剪）。
         Minimum/Maximum/Step 配置边界与刻度；属性网格中 RangeValue 类型的属性行内部即此控件。 -->
    <Style TargetType="{x:Type local:RangeSliderControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RangeSliderControl}">
                    <Grid>
                        <hc:RangeSlider x:Name="PART_Slider"
                                        Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                        Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                        TickFrequency="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsSnapToTickEnabled="True"
                                        ValueStart="{Binding ValueStart, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        ValueEnd="{Binding ValueEnd, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InverseBool}}"
                                        VerticalAlignment="Center"/>

                        <!-- 拖动数值气泡：贴在滑块上方（负上边距，不进占位），不参与命中测试 -->
                        <Border x:Name="PART_DragTip"
                                Visibility="Collapsed"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="10" Padding="10,3,10,4"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,-26,0,0"
                                IsHitTestVisible="False"
                                Panel.ZIndex="9">
                            <TextBlock x:Name="PART_DragTipText"
                                       Foreground="White" FontSize="12"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== FormulaSwitchControl 样式（普通输入 ↔ 公式绑定 切换控件，可独立使用） ==========
         普通模式：值输入框 + 🔗；点击 🔗（IsFormulaMode=true）整行切换为公式绑定条
         （FormulaBindingControl：公式输入 + 公式树选择），再点切回普通输入。
         只读时输入框只读、切换按钮禁用。属性行「普通值/公式绑定」覆盖式编辑即此交互模型。 -->
    <Style TargetType="{x:Type local:FormulaSwitchControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FormulaSwitchControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 列0：普通输入框与公式绑定条随 IsFormulaMode 互斥显隐，只占一个 -->
                        <hc:TextBox x:Name="PART_TextBox"
                                    Grid.Column="0"
                                    Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                    hc:InfoElement.Placeholder="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}"
                                    VerticalContentAlignment="Center"
                                    Margin="0"
                                    Visibility="{Binding IsFormulaMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <local:FormulaBindingControl x:Name="PART_FormulaBinding"
                                                     Grid.Column="0"
                                                     Compact="{Binding Compact, RelativeSource={RelativeSource TemplatedParent}}"

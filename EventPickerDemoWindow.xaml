<Window x:Class="PropertyGridDemo.EventPickerDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:pgc="clr-namespace:PropertyGridLib.Controls;assembly=PropertyGridLib"
        Title="EventPicker 独立事件编辑器演示"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：事件源预览 -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="事件源（WPF Button）"
                       FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <Button Content="目标按钮（查看其事件）" Padding="16,8"
                            Click="OnSourceButtonClick"/>
                    <TextBlock Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap">
                        右侧 EventPicker 自动反射选中对象（Button）的全部公共事件。
                        双击事件行或点 ⚡ 触发 EditRequested（宿主可接代码编辑器）。
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="说明" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource RegionBrush}"
                    CornerRadius="8" Padding="12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                    PropertyGrid 与事件编辑器（EventPicker）已拆分为两个独立控件。
                    属性页签刷新不再触发事件反射构建，快速切换对象不卡顿。
                    事件数据仅在事件页签激活时构建（EventPicker.SelectedObject 反射 / 宿主注入 Events）。
                </TextBlock>
            </Border>
        </DockPanel>

        <!-- 右侧：EventPicker -->
        <Border Grid.Column="2" Background="{DynamicResource SecondaryRegionBrush}"
                CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="EventPicker（独立控件）"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                <pgc:EventPicker x:Name="EventPicker"
                                 EditRequested="OnEventEditRequested"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

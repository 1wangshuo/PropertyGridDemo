<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 本机用户级 NuGet 配置里有一个已不存在的本地源，会让本解决方案还原直接报 NU1301。
         这里清掉继承来的包源，只用 nuget.org，保证 sln 在 Visual Studio 和命令行都能直接还原。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

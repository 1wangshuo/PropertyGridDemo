<hc:Window x:Class="PropertyGridDemo.CollectionEditorDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:PropertyGridLib;assembly=PropertyGridLib"
        xmlns:local="clr-namespace:PropertyGridLib.Controls;assembly=PropertyGridLib"
        xmlns:models="clr-namespace:PropertyGridDemo.Models"
        Title="控件独立使用演示" Height="700" Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <models:DemoFormulaTreeProvider x:Key="demoProvider"/>
    </Window.Resources>

    <Grid Margin="16">
        <TabControl>
            <!-- ==================== Tab1: 集合编辑器内联 ==================== -->
            <TabItem Header="集合编辑器内联">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="选择演示类型：" VerticalAlignment="Center" Margin="0,0,12,0"
                                   FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="List&lt;string&gt;" Padding="14,6" Margin="0,0,8,0"
                                Click="ShowStringList_Click"/>
                        <Button Content="List&lt;int&gt;" Padding="14,6" Margin="0,0,8,0"
                                Click="ShowIntList_Click"/>
                        <Button Content="List&lt;SampleObject&gt;" Padding="14,6"
                                Click="ShowObjectList_Click"/>
                    </StackPanel>

                    <controls:PropertyGrid x:Name="collectionPropertyGrid"
                                           Grid.Row="1"
                                           ShowSearchBar="True"/>
                </Grid>
            </TabItem>

            <!-- ==================== Tab: 字典编辑器 ==================== -->
            <TabItem Header="字典编辑器内联">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="选择演示类型：" VerticalAlignment="Center" Margin="0,0,12,0"
                                   FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="Dictionary&lt;string,int&gt;" Padding="14,6" Margin="0,0,8,8"
                                Click="ShowStringIntDict_Click"/>
                        <Button Content="复杂值 Dictionary&lt;string,SampleObject2&gt;" Padding="14,6" Margin="0,0,8,8"
                                Click="ShowComplexValueDict_Click"/>
                        <Button Content="复杂键 Dictionary&lt;ServerEndpoint,string&gt;" Padding="14,6" Margin="0,0,8,8"
                                Click="ShowComplexKeyDict_Click"/>
                        <Button Content="键值都是对象（左右各 50%）" Padding="14,6" Margin="0,0,8,8"
                                Click="ShowBothComplexDict_Click"/>
                    </WrapPanel>

                    <controls:PropertyGrid x:Name="dictionaryPropertyGrid"
                                           Grid.Row="1"
                                           ShowSearchBar="True"/>
                </Grid>
            </TabItem>

            <!-- ==================== Tab2: FormulaBindingControl 独立使用 ==================== -->
            <TabItem Header="公式绑定控件独立使用">
                <Grid Margin="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="FormulaBindingControl 可脱离 PropertyGrid 独立使用，通过 FormulaTreeProvider 或 TreeItemsSource 设置树数据"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- 方式一：通过 FormulaTreeProvider -->
                    <Border Grid.Row="1" Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="方式一：FormulaTreeProvider（推荐）" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="设置 FormulaTreeProvider 属性，控件自动调用 GetFormulaTree() 获取树节点"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="公式：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:FormulaBindingControl x:Name="formulaControl1"
                                                             Grid.Column="1"
                                                             FormulaTreeProvider="{StaticResource demoProvider}"
                                                             FormulaString="{Binding Formula1, Mode=TwoWay}"
                                                             Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 方式二：通过 TreeItemsSource -->
                    <Border Grid.Row="2" Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="方式二：TreeItemsSource（直接绑定树数据）" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="直接设置 TreeItemsSource 为 FormulaTreeNode 集合，无需 Provider"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="公式：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:FormulaBindingControl x:Name="formulaControl2"
                                                             Grid.Column="1"
                                                             TreeItemsSource="{Binding DirectTreeNodes}"
                                                             FormulaString="{Binding Formula2, Mode=TwoWay}"
                                                             Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 当前公式值显示 -->
                    <Border Grid.Row="3" Background="{DynamicResource RegionBrush}"
                            CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="当前公式值（实时绑定）" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="formulaValuesText"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== Tab: 路径选择 + 绑定切换（SDK 独立控件） ==================== -->
            <TabItem Header="路径/绑定切换控件">
                <Grid Margin="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="FilePathControl（文件/目录选择）与 FormulaSwitchControl（普通输入 ↔ 公式绑定切换）均可脱离 PropertyGrid 独立使用，开放给宿主直接实例化或绑定"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- 文件/目录选择控件 -->
                    <Border Grid.Row="1" Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="FilePathControl：文本框 + 「...」浏览" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文件：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:FilePathControl Grid.Column="1"
                                                       Text="{Binding SdkFilePath, Mode=TwoWay}"
                                                       Filter="*.log"
                                                       Margin="0,4"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="目录：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:FilePathControl Grid.Column="1"
                                                       Text="{Binding SdkDirectory, Mode=TwoWay}"
                                                       SelectDirectory="True"
                                                       Margin="0,4"/>
                            </Grid>
                            <TextBlock Text="{Binding SdkFilePath, StringFormat=当前文件值: {0}}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 普通 ↔ 绑定 切换控件 -->
                    <Border Grid.Row="2" Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="FormulaSwitchControl：普通输入 ↔ 公式绑定（🔗 切换）" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="值：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:FormulaSwitchControl Grid.Column="1"
                                                            Text="{Binding SdkSwitchText, Mode=TwoWay}"
                                                            FormulaString="{Binding SdkSwitchFormula, Mode=TwoWay}"
                                                            TreeItemsSource="{Binding DirectTreeNodes}"
                                                            Margin="0,4"/>
                            </Grid>
                            <TextBlock Text="{Binding SdkSwitchFormula, StringFormat=当前公式: {0}}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="默认态：上面的 FormulaString 已有内容（&amp;{Sensors,Temperature,Value}），控件打开即处于「公式绑定」状态（进去了），而不是停在普通输入框上；点 ✕ 或再次点击 🔗 可切回普通输入，之后不会再被自动拉回。若公式为空则默认就是普通输入。"/>
                        </StackPanel>
                    </Border>

                    <!-- 占位区（与其他页签高度一致） -->
                    <Border Grid.Row="3" Background="{DynamicResource RegionBrush}"
                            CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="两个控件均可独立实例化：FilePathControl（Text/Filter/Title/SelectDirectory/IsReadOnly）、FormulaSwitchControl（Text/FormulaString/TreeItemsSource/FormulaTreeProvider/IsFormulaMode/IsReadOnly/Compact）"
                                   FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </TabItem>
            <!-- ==================== Tab: 范围滑块独立控件 ==================== -->
            <TabItem Header="范围滑块控件">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="RangeSliderControl：双滑块选择区间，Minimum / Maximum / Step 配置边界与刻度；Value 双向绑定 RangeValue，宿主直接读 .Min / .Max。属性网格里声明 RangeValue 类型的属性也用它，[RangeSlider] 特性可配边界"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="带边界的区间（0 ~ 1920，步长 8）" FontWeight="Bold"
                                       FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <local:RangeSliderControl Minimum="0" Maximum="1920" Step="8"
                                                      Value="{Binding SdkRange, Mode=TwoWay}"
                                                      Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SdkRangeText}"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="拖动任一端 → 控件合成新的 RangeValue 写回宿主属性，上面的文字实时读 SdkRange.Min / SdkRange.Max"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ==================== Tab: 事件编辑器独立控件 ==================== -->
            <TabItem Header="事件编辑器独立">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="EventEditorControl：处理方法名输入框 + ⚡ 编辑按钮。可脱离 EventPicker/PropertyGrid 独立使用，绑定 HandlerName / IsReadOnly / Placeholder 即可"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="处理方法：" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:EventEditorControl HandlerName="{Binding SdkHandlerName, Mode=TwoWay}"
                                                          Placeholder="点右侧 ⚡ 编辑，或直接输入方法名"/>
                            </Grid>
                            <TextBlock Text="{Binding SdkHandlerName, StringFormat=当前处理方法: {0}}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="⚡ 编辑请求以路由事件冒泡（EditRequested），宿主监听到后弹自己的方法选择窗；无宿主接管时对 EventItem 走默认建议名。"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ==================== Tab: 集合/字典编辑器独立控件 ==================== -->
            <TabItem Header="集合/字典编辑器独立">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="CollectionEditorControl（集合）/ DictionaryEditorControl（字典）：设 Compact=&quot;True&quot; 即为一行「值框 + ...」，点 ... 打开编辑器弹窗；不设则显示完整内联面板"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CollectionEditorControl（Compact 紧凑形态）" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="值班人员列表：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:CollectionEditorControl Grid.Column="1" Compact="True"
                                                               Items="{Binding DemoCollection}"/>
                            </Grid>
                            <TextBlock Text="{Binding DemoCollectionSummary, StringFormat=当前内容: {0}}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="DictionaryEditorControl（Compact 紧凑形态）" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="通讯参数表：" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <local:DictionaryEditorControl Grid.Column="1" Compact="True"
                                                               Items="{Binding DemoDictionary}"/>
                            </Grid>
                            <TextBlock Text="紧凑形态与网格行（[3 项] ... 那条）是同一套视觉，点 ... 复用网格行同款编辑弹窗。"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</hc:Window>

<hc:Window x:Class="PropertyGridDemo.FormLayoutDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:pg="clr-namespace:PropertyGridLib;assembly=PropertyGridLib"
        xmlns:local="clr-namespace:PropertyGridDemo"
        Title="形态展示：隐藏开关 / 无分类平铺 / 表单式 / 链接"
        Width="1180" Height="760"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="16">
        <!-- 顶部：形态开关 -->
        <Border DockPanel.Dock="Top" Padding="12,10" Margin="0,0,0,12"
                BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SecondaryRegionBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="形态开关：" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                <CheckBox x:Name="chkSearch" Content="显示搜索框" IsChecked="False"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="Shape_Changed" Unchecked="Shape_Changed"/>
                <CheckBox x:Name="chkExpand" Content="显示 展开/折叠" IsChecked="False"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="Shape_Changed" Unchecked="Shape_Changed"/>
                <CheckBox x:Name="chkCategory" Content="显示分类头" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="Shape_Changed" Unchecked="Shape_Changed"/>
                <CheckBox x:Name="chkSection" Content="Pro 用表单式（VS2026）" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="Shape_Changed" Unchecked="Shape_Changed"/>
                <CheckBox x:Name="chkHeader" Content="Pro 显示标题区" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="Shape_Changed" Unchecked="Shape_Changed"/>
                <TextBlock Text="链接属性可直接点击打开" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：基础 PropertyGrid（Left 紧凑布局，工具条可全隐藏） -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="PropertyGrid · 紧凑布局（标题在左）"
                           FontWeight="Bold" Margin="2,0,0,8"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Border BorderThickness="1" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Background="{DynamicResource RegionBrush}">
                    <!-- 标题用控件默认值（「属性」），不在这里重复设置 -->
                    <pg:PropertyGrid x:Name="grid"
                                     TitlePlacement="Left"
                                     ShowSearchBar="True"
                                     ShowExpandCollapse="True"
                                     ShowCategoryHeaders="True"
                                     FontSize="14"
                                     FontFamily="Consolas"
                                     Margin="4"/>
                </Border>
            </DockPanel>

            <!-- 右：PropertyGridPro（表单式 / 卡片式） -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="PropertyGridPro · 表单式（VS 2026 选项页）"
                           FontWeight="Bold" Margin="2,0,0,8"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <!-- 标题用控件默认值（「属性」），与左侧基础网格保持一致；
                     需要「项目属性」这类语境时再显式设 Header -->
                <pg:PropertyGridPro x:Name="proGrid"
                                    HeaderDescription="分类名占左列；每条属性为「名称 → 说明 → 编辑器」上下排布，布尔属性是勾选项，关键属性左侧带强调色竖线。"
                                    ShowHeader="True"
                                    ShowSearchBar="True"
                                    ShowCategoryHeaders="True"
                                    Layout="Section"
                                    EditorWidth="320"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</hc:Window>

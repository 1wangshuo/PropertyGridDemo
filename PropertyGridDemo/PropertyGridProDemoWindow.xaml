<hc:Window x:Class="PropertyGridDemo.PropertyGridProDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:pg="clr-namespace:PropertyGridLib;assembly=PropertyGridLib"
        Title="PropertyGridPro 演示 - 主题自适应平铺参数面板"
        Height="760" Width="1180"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <!-- 左面板宽度可拖：初始 640，最小 420（再窄标题列就没有呼吸空间），
                 拖动时实时重排，可直观看到行内容始终靠左、编辑器紧跟标题、空白留在右侧 -->
            <ColumnDefinition Width="640" MinWidth="420"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧：PropertyGridPro ========== -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Text="PropertyGridPro 控件（纵向平铺 / 不折叠 / 带属性搜索）"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="8" Padding="12" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="从模型刷新" Padding="14,6" Margin="0,0,8,0"
                            Click="Refresh_Click"/>
                    <Button Content="恢复默认值" Padding="14,6" Margin="0,0,8,0"
                            Click="ResetAll_Click"/>
                    <Button Content="切换主题" Padding="14,6" Margin="0,0,8,0"
                            Click="ToggleTheme_Click"/>
                    <TextBlock x:Name="txtTheme" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" CornerRadius="6" Padding="10,6" Margin="0,0,8,8"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12">
                    <Run Text="↔ 拖动两栏中间的分割条把面板拉宽：属性名始终贴卡片左缘，值编辑器固定在卡片右侧（宽 300），多出来的空间落在两栏之间。"/>
                </TextBlock>
            </Border>

            <pg:PropertyGridPro x:Name="proGrid"
                                Margin="0,0,8,0"
                                EditorWidth="300"
                                Header="参数配置"
                                HeaderDescription="平铺参数面板示例：与 PropertyGrid 演示共用同一模型（PropertyGridDemo.Models.SampleObject，智能监控摄像头配置，I ~ XV 共 15 个分组）。顶部搜索框支持多关键词过滤（空格分隔），匹配显示名、属性名、说明与分类。"
                                SourceText="来源扩展：PropertyGridDemo.Models.SampleObject"
                                ShowHeader="True"
                                ShowSearchBar="True"
                                ShowCategoryHeaders="True"
                                PropertyValueChanged="ProGrid_PropertyValueChanged"
                                ButtonClicked="ProGrid_ButtonClicked"/>
        </DockPanel>

        <!-- ========== 可拖拽分割条（10px 热区，中间 2px 主题色竖线，悬停/按下变主题主色） ========== -->
        <GridSplitter Grid.Column="1" Width="10"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="BasedOnAlignment"
                      ResizeDirection="Columns"
                      ShowsPreview="False"
                      Background="Transparent"
                      KeyboardNavigation.IsTabStop="False"
                      ToolTip="拖动调整参数面板宽度">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}">
                        <Border Width="2" HorizontalAlignment="Center"
                                CornerRadius="1"
                                Background="{DynamicResource BorderBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ========== 右侧：使用说明 ========== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="使用说明" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20">
                            <Run Text="1. 平铺不折叠：每一项都是独立行，左侧属性名 + 次级说明文字，右侧值编辑器；"/>
                            <LineBreak/>
                            <Run Text="2. 属性搜索：顶部搜索框实时过滤，尝试输入 “摄像头”、“灵敏度”、“固件”，或多关键词 “存储 目录”；"/>
                            <LineBreak/>
                            <Run Text="3. 与 PropertyGrid 共用同一套反射体系（PropertyItemFactory / PropertyItem / EditorSelector），"/>
                            <LineBreak/>
                            <Run Text="    因此 [NumberSlider]、[FilePath]、[DirectoryPath]、[Button]、[TypeConverter] 下拉、[ReadOnly] 等编辑器行为完全一致；"/>
                            <LineBreak/>
                            <Run Text="3.1 布尔开关：[ToggleSwitch] / [ToggleSwitch(&quot;已启用&quot;,&quot;已禁用&quot;)] 标注的 bool 属性和基类 PropertyGrid 一样显示为开关（ToggleSwitch）样式，见 “XIV. 布尔开关（ToggleSwitch）演示 ★” 分组；未标注的 bool 保持原有显示；"/>
                            <LineBreak/>
                            <Run Text="4. 点击“抓拍”/“重启”按钮：反射调用模型方法，只读项“抓拍次数”随面板刷新（“导出配置”未指定 Action，仅触发 ButtonClicked 事件）；"/>
                            <LineBreak/>
                            <Run Text="5. 配色跟随主题：面板不定义任何自定义画刷，全部取自项目现有主题键（RegionBrush / SecondaryRegionBrush / BorderBrush / PrimaryTextBrush / SecondaryTextBrush / PrimaryBrush），点击“切换主题”可在浅色与深色间即时切换验证。"/>
                            <LineBreak/>
                            <Run Text="6. 公式绑定：[FormulaEditor] / FormulaBound&lt;T&gt; 属性（如“IX. 公式绑定”分组下的摄像头名称绑定、标定比例绑定）在值编辑器下方显示公式栏，点击链接图标从公式树中选择绑定源，行为与 PropertyGrid 完全一致。公式已有内容时该行默认就是展开的绑定状态（如“标定比例绑定”已预置 &amp;{Flow1,Task2,Output}），不用再手动点开。"/>
                            <LineBreak/>
                            <Run Text="7. 宽度自适应：拖动两栏之间的分割条（或直接把窗口拉宽）——属性名贴卡片左缘、值编辑器固定在卡片右侧，新增空间落在两栏之间；拖窄时先压缩标题列（超长名单行省略），编辑器宽度始终保持不变。"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</hc:Window>
